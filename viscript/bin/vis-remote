#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# vis-remote — chạy **một lệnh bash** trên mac / ps / psvn với năm bảo đảm (ST-162, +ST-175).
#
# Vì sao cần: sự cố R28 §5 #4/#5/#6 (đêm 16→17/11) làm mất bằng chứng cổng:
#   #4 `ssh psvn '& "…bash.exe" -lc "…; echo EXIT=$?"'` ⇒ **PowerShell nội suy `$?`**
#      (`EXIT=True`) ⇒ không có mã thoát thật.
#   #5 `cd viscript && …` dùng **đường log tương đối** ⇒ log sai chỗ / không thu về được.
#   #6 trên `ps`, `../vis-dev`/`cargo` **không có trong PATH** của phiên ssh (`$HOME/.cargo/bin`)
#      ⇒ lần chạy đầu fail vì môi trường, không phải vì mã.
#   (#7 kèm theo) log đo trên `psvn` ghi **trong repo** ⇒ tệp untracked **chặn `git pull --ff-only`**.
#
# Ba bảo đảm của công cụ này:
#   1. **ĐƯỜNG TUYỆT ĐỐI** — `cargo` dò và ghim tuyệt đối (`$HOME/.cargo/bin/cargo`, …), mọi
#      đường log là tuyệt đối; không còn `cd <tương đối> && …`.
#   2. **MÃ THOÁT RA TỆP `.exit`** — thân chạy kết thúc bằng `echo $? > "<log>.exit"` **bên trong
#      bash trên máy đích**, rồi **đọc lại từ tệp** (`cat`). Không bao giờ lấy mã từ `$?` của
#      PowerShell / của `ssh`. Trên `psvn` chuỗi `$?`/`$LASTEXITCODE` chỉ còn là gợi ý, không là bằng chứng.
#   3. **LOG NGOÀI REPO** — log + `.exit` ghi vào `<home máy đích>/vislogs/` (`psvn`:
#      `/c/Users/ps/vislogs/`), **không** ghi trong repo ⇒ không sinh tệp untracked chặn `git pull`.
#      `--log` chỉ đổi **bản sao cục bộ**; nếu bản sao nằm trong repo thì **cảnh báo** (vẫn ghi, để
#      chép bằng chứng vào `JOURNAL/`).
#   4. **HEADER MÔI TRƯỜNG (VD-136)** — máy, OS/kernel, rustc/cargo, HEAD, git status, lệnh, UTC
#      bắt đầu/kết thúc và `[exit=N]` lấy từ `.exit`.
#   5. **TỪ CHỐI CÂY BẨN (ST-175, VD-177 §4)** — trước khi chạy lệnh trên `ps`/`psvn`, kiểm
#      `git -C <repo> status --porcelain` (tệp bị `gitignore` không tính); **không rỗng ⇒ TỪ CHỐI**,
#      in số mục bẩn + 5 mục đầu + gợi ý (`git restore`/`git clean` hoặc clone sạch), mã thoát 6.
#      Lý do: `git rev-parse HEAD:viscript` chỉ là hash **của commit**, cây làm việc có thể đang mang
#      thay đổi chưa commit (bằng chứng ST-175: `/root/vifast-linux` bẩn 2338 mục, `viscript/` khác HEAD).
#      `mac` **không** kiểm theo mặc định (chính công cụ này ghi log vào repo; cây làm việc của agent
#      bẩn là bình thường) — muốn kiểm trên mac thì `--require-clean`. `--check` không kiểm (chẩn đoán).
#
# Dùng:
#   bin/vis-remote <host> [--log <tệp>] [--tag <nhãn>] [--allow-dirty|--require-clean] -- <lệnh> [đối số…]
#   bin/vis-remote <host> --check [--log <tệp>]   # in môi trường + `.exit` của `true`/`false`
#   bin/vis-remote --hosts                        # in cấu hình từng máy (kèm chế độ kiểm cây bẩn)
#   bin/vis-remote -h | --help
#
#   <host>: mac | ps | psvn   (đồng nghĩa: local|macos ⇒ mac · linux ⇒ ps · windows ⇒ psvn)
#
#   --allow-dirty    BỎ kiểm cây bẩn — **CHỈ để chẩn đoán** (đo trên cây bẩn không chứng minh được mã
#                    khớp commit); không dùng cho phép đo.
#   --require-clean  BẬT kiểm cây bẩn cả trên `mac` (mặc định mac không kiểm — xem bảo đảm 5).
#
#   bin/vis-remote ps -- bash -lc 'cd viscript && bin/vis-dev check'
#   bin/vis-remote psvn --log /tmp/psvn.log -- git log --oneline -1
#   bin/vis-remote psvn --check
#
# Chuyển thân chạy sang máy đích: **stdin** (`bash -s`) cho cả ba nền — nhờ vậy nội dung script
# không bao giờ đi qua dòng lệnh PowerShell (đó chính là đường làm hỏng `$?` và `"` của sự cố #4).
#
# stdout = đầu ra của lệnh **+ đúng một dòng cảm biến** `vis-remote-exit=<N>` ở cuối (giá trị **đọc
# lại từ tệp `.exit`**, không phải `$?`); mã thoát của chính `vis-remote` cũng là N. Log cục bộ =
# header VD-136 + đầu ra + khối `# ---------- KET ----------` kết thúc bằng `[exit=N]`.
#
# Biến môi trường (đều là *đường tuyệt đối*):
#   VIS_REMOTE_PS_SSH     đích ssh cho `ps`   (mặc định `root@ps`)
#   VIS_REMOTE_PSVN_SSH   đích ssh cho `psvn` (mặc định `psvn`)
#   VIS_REMOTE_PSVN_BASH  bash của Git trên `psvn` (mặc định `C:\Program Files\Git\bin\bash.exe`)
#   VIS_REMOTE_MAC_REPO / _PS_REPO / _PSVN_REPO   thư mục cây nguồn trên từng máy
#   VIS_REMOTE_MAC_HOME / _PS_HOME / _PSVN_HOME   home trên từng máy (mặc định: dò bằng `cd ~ && pwd -P`)
#   VIS_REMOTE_TAG        nhãn mặc định của log (mặc định `vis-remote`)
#
# Mã thoát: 0..255 = **mã thật của lệnh, đọc từ tệp `.exit`** · 2 dùng sai · 3 BLOCKED-ENV
#           (không ssh được / thiếu cây nguồn / không tạo được thư mục log) · 4 không đọc được `.exit`
#           (`--check`: 0 khớp `true`=0 và `false`=1 · 5 lệch) · 6 cây nguồn BẨN ⇒ từ chối chạy
#           (`--allow-dirty` để bỏ kiểm; chỉ dùng để chẩn đoán).
#
# KHÔNG đồng bộ cây nguồn (khác `bin/vis-linux`): muốn đồng bộ thì chạy `bin/vis-linux sync` trước.
set -u

VIS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$VIS_ROOT/.." && pwd)"

PS_SSH="${VIS_REMOTE_PS_SSH:-root@ps}"
PSVN_SSH="${VIS_REMOTE_PSVN_SSH:-psvn}"
PSVN_BASH="${VIS_REMOTE_PSVN_BASH:-C:\\Program Files\\Git\\bin\\bash.exe}"

repo_of() {
    case "$1" in
        mac) echo "${VIS_REMOTE_MAC_REPO:-$REPO_ROOT}" ;;
        ps) echo "${VIS_REMOTE_PS_REPO:-/root/vifast-linux}" ;;
        psvn) echo "${VIS_REMOTE_PSVN_REPO:-/c/Users/ps/vifast-windows/repo}" ;;
    esac
}

home_hint_of() {
    case "$1" in
        mac) echo "${VIS_REMOTE_MAC_HOME:-}" ;;
        ps) echo "${VIS_REMOTE_PS_HOME:-/root}" ;;
        psvn) echo "${VIS_REMOTE_PSVN_HOME:-/c/Users/ps}" ;;
    esac
}

cargo_hint_of() {
    case "$1" in
        mac) echo "${VIS_REMOTE_MAC_CARGO:-$HOME/.cargo/bin/cargo}" ;;
        ps) echo "${VIS_REMOTE_PS_CARGO:-/root/.cargo/bin/cargo}" ;;
        psvn) echo "${VIS_REMOTE_PSVN_CARGO:-/c/Users/ps/.cargo/bin/cargo}" ;;
    esac
}

die() { echo "vis-remote: $2" >&2; exit "$1"; }
say() { echo "vis-remote: $*" >&2; }

utc_stem() { date -u +%Y%m%dT%H%M%SZ; }
utc_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

sha256_file() {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
    else echo "khong-co-sha256"; fi
}

normalize_host() {
    case "$1" in
        mac|local|macos) echo mac ;;
        ps|linux) echo ps ;;
        psvn|windows) echo psvn ;;
        *) return 1 ;;
    esac
}

# Chuyển một script (tệp) sang máy đích và chạy; stdout của nó là stdout của hàm.
# **stdin = script** cho cả ba nền ⇒ nội dung không đi qua dòng lệnh của PowerShell (#4).
transport_run() { # $1 = host, $2 = tệp script
    case "$1" in
        mac) bash -s <"$2" ;;
        ps) ssh -o BatchMode=yes -o ConnectTimeout=10 "$PS_SSH" 'exec bash -s' <"$2" ;;
        psvn) ssh -o BatchMode=yes -o ConnectTimeout=10 "$PSVN_SSH" "& '$PSVN_BASH' -s" <"$2" ;;
        *) die 2 "transport_run: host '$1' lạ" ;;
    esac
}

# Đoạn đầu dùng chung: dò `cargo` tuyệt đối rồi ghim `CARGO` + `PATH` (bảo đảm 1).
COMMON_HEAD='set +u
VIS_CARGO=""
for _c in "$VIS_CARGO_HINT" "$HOME/.cargo/bin/cargo" /usr/local/bin/cargo /usr/bin/cargo "$HOME/.local/bin/cargo"; do
    if [ -n "$_c" ] && [ -x "$_c" ]; then VIS_CARGO="$_c"; break; fi
done
if [ -z "$VIS_CARGO" ]; then
    _cc="$(command -v cargo 2>/dev/null || true)"
    [ -n "$_cc" ] && VIS_CARGO="$_cc"
fi
[ -n "$VIS_CARGO" ] || VIS_CARGO="cargo"
export CARGO="$VIS_CARGO"
case "$VIS_CARGO" in
    /*) export PATH="$(dirname "$VIS_CARGO"):/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH" ;;
    *)  export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH" ;;
esac
VIS_RUSTC=""
if [ -x "$(dirname "$VIS_CARGO")/rustc" ]; then VIS_RUSTC="$(dirname "$VIS_CARGO")/rustc"
else VIS_RUSTC="$(command -v rustc 2>/dev/null || echo none)"; fi
export RUSTC="$VIS_RUSTC"'

# Ghi một tệp script từ các mảnh: `printf` cho phần có biến, heredoc cho phần tĩnh.
emit_probe_script() { # $1 = tệp, $2 = host, $3 = cargo hint, $4 = repo
    local out="$1" host="$2" chint="$3" repo="$4"
    {
        printf '#!/usr/bin/env bash\n# vis-remote: DÒ MÔI TRƯỜNG trên %s — sinh tự động, không sửa tay\n' "$host"
        printf 'VIS_CARGO_HINT=%s\n' "$(printf '%q' "$chint")"
        printf 'VIS_REPO=%s\n' "$(printf '%q' "$repo")"
        printf 'VIS_HOST=%s\n' "$(printf '%q' "$host")"
        printf '%s\n' "$COMMON_HEAD"
        cat <<'EOS'
cd "$VIS_REPO" 2>/dev/null || true
printf 'may: %s\n'        "$(hostname 2>/dev/null || echo '?')"
printf 'nhan: %s\n'       "$(uname -srm 2>/dev/null || echo '?')"
if command -v sw_vers >/dev/null 2>&1; then
    printf 'os: macOS %s\n' "$(sw_vers -productVersion 2>/dev/null || echo '?')"
elif [ -r /etc/os-release ]; then
    PRETTY_NAME=""; . /etc/os-release 2>/dev/null
    printf 'os: %s\n' "${PRETTY_NAME:-$(uname -s)}"
else
    printf 'os: %s\n' "$(uname -s 2>/dev/null || echo '?')"
fi
printf 'nproc: %s\n'      "$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo '?')"
printf 'shell: %s (bash %s)\n' "${SHELL:-?}" "${BASH_VERSION:-?}"
printf 'cargo: %s\n'      "$( ("$VIS_CARGO" --version 2>&1 | head -1) || echo '?')"
printf 'cargo_duong_dan: %s\n' "$VIS_CARGO"
printf 'rustc: %s\n'      "$( ("$VIS_RUSTC" --version 2>&1 | head -1) || echo '?')"
printf 'rustc_duong_dan: %s\n' "$VIS_RUSTC"
printf 'repo: %s\n'       "$(pwd)"
printf 'head_full: %s\n'  "$(git rev-parse HEAD 2>/dev/null || echo '?')"
printf 'head_ngan: %s\n'  "$(git rev-parse --short HEAD 2>/dev/null || echo '?')"
printf 'git_nhanh: %s\n'  "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
printf 'git_untracked: %s\n' "$(git status --porcelain 2>/dev/null | grep -c '^??' || true)"
printf 'git_status: %s\n' "$(git status --porcelain 2>/dev/null | head -6 | tr '\n' '|')"
printf 'vis-remote-home: %s\n' "$(cd "$HOME" 2>/dev/null && pwd -P)"
EOS
    } >"$out"
}

emit_run_script() { # $1 tệp · $2 host · $3 cargo hint · $4 repo · $5 log tuyệt đối trên máy đích · $6 argv đã %q
    local out="$1" host="$2" chint="$3" repo="$4" rlog="$5" argv="$6"
    {
        printf '#!/usr/bin/env bash\n# vis-remote: CHẠY MỘT LỆNH trên %s — sinh tự động, không sửa tay\n' "$host"
        printf '# log=%s\n' "$rlog"
        printf 'VIS_CARGO_HINT=%s\n' "$(printf '%q' "$chint")"
        printf 'VIS_REPO=%s\n' "$(printf '%q' "$repo")"
        printf 'VIS_LOG=%s\n' "$(printf '%q' "$rlog")"
        printf 'VIS_HOST=%s\n' "$(printf '%q' "$host")"
        printf 'VIS_DIRTY_POLICY=%s\n' "$(printf '%q' "$DIRTY_POLICY")"
        printf 'VIS_ARGV=%s\n' "$argv"
        printf '%s\n' "$COMMON_HEAD"
        cat <<'EOS'
cd "$VIS_REPO" || { echo "vis-remote: không vào được cây nguồn '$VIS_REPO'" >&2; exit 3; }
mkdir -p "$(dirname "$VIS_LOG")" || { echo "vis-remote: không tạo được thư mục log '$(dirname "$VIS_LOG")'" >&2; exit 3; }
set -u
set -o pipefail
# ---------- ST-175 (VD-177 §4): TỪ CHỐI CÂY BẨN TRƯỚC KHI ĐO ----------
# `git status --porcelain` đã bỏ qua tệp bị `.gitignore`; rỗng = cây khớp commit.
if [ "${VIS_DIRTY_POLICY:-skip}" = check ]; then
    _vr_dirty="$(git -C "$VIS_REPO" status --porcelain 2>/dev/null || true)"
    if [ -n "$_vr_dirty" ]; then
        _vr_n="$(printf '%s\n' "$_vr_dirty" | grep -c . || true)"
        {
            printf '# ---------- ST-175: TU CHOI CAY BAN ----------\n'
            printf '# may: %s · cay: %s\n' "$VIS_HOST" "$VIS_REPO"
            printf '# so_muc_ban=%s (git status --porcelain, da bo qua tep bi gitignore)\n' "$_vr_n"
            printf '# 5 muc dau:\n'
            printf '%s\n' "$_vr_dirty" | head -5 | sed 's/^/#   /'
            printf '%s\n' '# => TU CHOI: cay khong sach, so do tren cay ban KHONG chung minh duoc ma khop commit.'
            printf '%s\n' '# goi y: git -C <repo> restore .  ·  git -C <repo> clean -fd  ·  hoac do tren clone/worktree sach'
            printf '%s\n' '# (chi chan doan moi dung --allow-dirty: co y bo kiem, KHONG dung cho phep do)'
            printf '# ma thoat=6 (BLOCKED-DIRTY)\n'
        } | tee -a "$VIS_LOG"
        printf '%s\n' 6 >"$VIS_LOG.exit"
        printf 'vis-remote-exit=6\n'
        exit 6
    fi
    printf '%s\n' '# ST-175: cay SACH (git status --porcelain rong) — duoc phep chay/do'
fi
# stdin của lệnh = /dev/null: lệnh không ăn mất phần script còn lại đang đọc từ stdin (#4).
{ "${VIS_ARGV[@]}" ; } </dev/null 2>&1 | tee -a "$VIS_LOG"
_vis_rc=${PIPESTATUS[0]}
printf '%s\n' "$_vis_rc" >"$VIS_LOG.exit"
_vis_read="$(cat "$VIS_LOG.exit")"
printf 'vis-remote-exit=%s\n' "$_vis_read"
exit "$_vis_read"
EOS
    } >"$out"
}

# Gom argv thành literal mảng bash: ( 'a' 'b' … ) — không dùng eval.
argv_literal() {
    local q="" a
    for a in "$@"; do q="$q $(printf '%q' "$a")"; done
    printf '(%s )' "$q"
}

TMPDIR_VR="$(mktemp -d "${TMPDIR:-/tmp}/vis-remote.XXXXXX")" || die 3 "không tạo được thư mục tạm"
cleanup() { rm -rf "$TMPDIR_VR"; }
trap cleanup EXIT INT TERM

# Dò môi trường trên máy đích; in ra các dòng `khoá: giá trị` (không ghi log).
probe_host() { # $1 = host
    local host="$1" f="$TMPDIR_VR/probe-$1.sh" out
    emit_probe_script "$f" "$host" "$(cargo_hint_of "$host")" "$(repo_of "$host")" ||
        die 3 "không ghi được script dò môi trường"
    out="$(transport_run "$host" "$f")" || true
    printf '%s\n' "$out"
}

remote_home() { # $1 = host, $2 = các dòng probe
    local h hint
    h="$(home_hint_of "$1")"
    if [ -n "$h" ]; then printf '%s\n' "$h"; return 0; fi
    hint="$(printf '%s\n' "$2" | sed -n 's/^vis-remote-home: //p' | head -1)"
    [ -n "$hint" ] || die 3 "không dò được home trên '$1' (BLOCKED-ENV)"
    printf '%s\n' "$hint"
}

# Chạy một lệnh; in ra log (stdout) và trả mã thật qua biến toàn cục VR_EXIT.
# $1 host · $2 tệp log cục bộ · $3 stem log trên máy đích · $4.. argv
run_once() {
    local host="$1" log="$2" stem="$3"; shift 3
    local argv script probe rhome rlog out rc marker
    [ $# -gt 0 ] || die 2 "run: cần lệnh"
    argv="$(argv_literal "$@")"
    probe="$(probe_host "$host")" || die 3 "dò môi trường '$host' thất bại (BLOCKED-ENV)"
    printf '%s\n' "$probe" | grep -q '^head_full: ' ||
        die 3 "dò môi trường '$host' không trả HEAD — ssh hỏng? (BLOCKED-ENV)"
    rhome="$(remote_home "$host" "$probe")" || exit 3
    rlog="$rhome/vislogs/$stem.log"
    script="$TMPDIR_VR/run-$host-$stem.sh"
    emit_run_script "$script" "$host" "$(cargo_hint_of "$host")" "$(repo_of "$host")" "$rlog" "$argv" ||
        die 3 "không ghi được script chạy"

    mkdir -p "$(dirname "$log")" || die 3 "không tạo được thư mục log cục bộ '$(dirname "$log")'"
    {
        printf '# vis-remote — một lệnh bash trên %s (ST-162; sự cố R28 §5 #4/#5/#6)\n' "$host"
        printf '# thoi_diem_bat_dau=%s\n' "$(utc_iso)"
        printf '# host=%s\n' "$host"
        printf '# lenh: %s\n' "$(printf '%q ' "$@")"
        printf '# home_may_dich=%s\n' "$rhome"
        printf '# log_tren_may_dich=%s\n' "$rlog"
        printf '# exit_tren_may_dich=%s.exit\n' "$rlog"
        printf '# log_cuc_bo=%s\n' "$log"
        printf '# ---------- HEADER VD-136: DO TREN %s ----------\n' "$host"
        printf '%s\n' "$probe" | sed 's/^/# /'
        printf '# ---------- HET HEADER ----------\n'
    } >>"$log" || die 3 "không ghi được log '$log'"

    transport_run "$host" "$script" 2>&1 | tee -a "$log"
    rc=$?                                   # mã của `tee`/ssh: CHỈ để chẩn đoán, không phải bằng chứng
    marker="$(printf '%s\n' "$(tail -40 "$log")" | tr -d '\r' | sed -n 's/^vis-remote-exit=//p' | tail -1)"
    if [ -z "$marker" ]; then
        # Không thấy dấu đọc-từ-tệp: đọc `.exit` bằng một lần ssh riêng (vẫn là đọc TỆP, không `$?`).
        marker="$(read_exit_file "$host" "$rlog.exit")"
    fi
    [ -n "$marker" ] || {
        printf '# [exit=?] KHÔNG đọc được %s.exit (ssh rc=%s)\n' "$rlog" "$rc" >>"$log"
        say "[exit=?] không đọc được tệp .exit — BLOCKED-ENV"
        VR_EXIT=4
        return 4
    }
    {
        printf '# ---------- KET ----------\n'
        printf '# thoi_diem_ket_thuc=%s\n' "$(utc_iso)"
        printf '# ssh_rc=%s (chi de chan doan — KHONG phai bang chung)\n' "$rc"
        printf '# sha256(log_tren_may_dich)=%s\n' "$(remote_sha256 "$host" "$rlog")"
        printf '[exit=%s]\n' "$marker"
    } >>"$log"
    say "[exit=$marker] host=$host log=$log log_may_dich=$rlog"
    VR_EXIT="$marker"
    return 0
}

# Đọc tệp `.exit` bằng ssh riêng (bằng chứng là NỘI DUNG TỆP, không phải `$?`).
read_exit_file() { # $1 host, $2 đường tuyệt đối trên máy đích
    local host="$1" p="$2" f="$TMPDIR_VR/cat.sh" out
    {
        printf '# đọc TỆP .exit (không dùng $?)\n'
        printf 'cat %s 2>/dev/null || true\n' "$(printf '%q' "$p")"
    } >"$f"
    out="$(transport_run "$host" "$f" 2>/dev/null | tr -d '\r' | tr -d '\n')"
    printf '%s\n' "$out"
}

remote_sha256() { # $1 host, $2 đường tuyệt đối trên máy đích
    local host="$1" p="$2" f="$TMPDIR_VR/sha.sh" out
    {
        printf 'f=%s\n' "$(printf '%q' "$p")"
        printf '%s\n' 'if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$f" | cut -d" " -f1
elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$f" | cut -d" " -f1
else echo khong-co-sha256; fi'
    } >"$f"
    out="$(transport_run "$host" "$f" 2>/dev/null | tr -d '\r' | tr -d '\n')"
    printf '%s\n' "${out:-?}"
}

in_repo() { # $1 = đường tuyệt đối
    case "$1" in
        "$REPO_ROOT"/*) return 0 ;;
        *) return 1 ;;
    esac
}

cmd_hosts() {
    local h
    for h in mac ps psvn; do
        printf '%-5s repo=%-36s cargo=%-32s log_dir=%s/vislogs   kiem_cay_ban=%s\n' \
            "$h" "$(repo_of "$h")" "$(cargo_hint_of "$h")" "$(home_hint_of "$h")" \
            "$(default_dirty_policy "$h")"
    done
}

# Chính sách kiểm cây bẩn mặc định: `ps`/`psvn` = check (cây để đo); `mac` = skip.
# `mac` là cây làm việc của agent, chính `vis-remote` ghi log vào repo ⇒ kiểm ở đây sẽ chặn mọi việc.
# Muốn bật: `--require-clean`. Muốn tắt: `--allow-dirty` (chỉ để chẩn đoán).
default_dirty_policy() {
    case "$1" in
        ps|psvn) echo check ;;
        *) echo skip ;;
    esac
}

usage() { awk 'NR > 1 { if ($0 ~ /^set -u$/) exit; sub(/^# ?/, ""); print }' "$0"; }

main() {
    [ $# -gt 0 ] || { usage; exit 2; }
    case "$1" in
        -h|--help|help) usage; exit 0 ;;
        --hosts) cmd_hosts; exit 0 ;;
    esac

    local host_raw="$1"; shift
    local host; host="$(normalize_host "$host_raw")" || die 2 "host '$host_raw' lạ (mac|ps|psvn)"

    local log="" tag="${VIS_REMOTE_TAG:-vis-remote}" check=0 allow_dirty=0 require_clean=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --log) log="${2:?--log cần tệp}"; shift 2 ;;
            --tag) tag="${2:?--tag cần nhãn}"; shift 2 ;;
            --check) check=1; shift ;;
            --allow-dirty) allow_dirty=1; shift ;;
            --require-clean) require_clean=1; shift ;;
            --) shift; break ;;
            -h|--help) usage; exit 0 ;;
            *) break ;;
        esac
    done
    [ "$allow_dirty" = 1 ] && [ "$require_clean" = 1 ] &&
        die 2 "--allow-dirty và --require-clean loại trừ nhau"

    # ST-175 (VD-177 §4): mặc định kiểm cây bẩn trên máy ĐO (`ps`/`psvn`), không kiểm trên `mac`.
    DIRTY_POLICY="$(default_dirty_policy "$host")"
    [ "$allow_dirty" = 1 ] && DIRTY_POLICY=skip
    [ "$require_clean" = 1 ] && DIRTY_POLICY=check
    [ "$check" = 1 ] && DIRTY_POLICY=skip   # `--check` là chẩn đoán môi trường, không phải phép đo

    local stem; stem="$tag-$(utc_stem)"
    if [ -z "$log" ]; then
        log="$HOME/vislogs/$stem.log"
    else
        case "$log" in
            /*) ;;
            *) log="$PWD/$log" ;;
        esac
        # bảo đảm 3: bản sao cục bộ nằm trong repo thì cảnh báo (vẫn ghi — để chép bằng chứng)
        in_repo "$log" && say "CẢNH BÁO: log cục bộ nằm TRONG repo ($log) — log trên máy đích vẫn ở ngoài repo"
    fi

    if [ "$check" = 1 ]; then
        local probe rhome e_true e_false ok=0
        probe="$(probe_host "$host")" || die 3 "dò môi trường '$host' thất bại (BLOCKED-ENV)"
        printf '%s\n' "$probe" | grep -q '^head_full: ' ||
            die 3 "dò môi trường '$host' không trả HEAD — ssh hỏng? (BLOCKED-ENV)"
        rhome="$(remote_home "$host" "$probe")" || exit 3
        echo "== vis-remote --check · host=$host =="
        printf '%s\n' "$probe" | grep -v '^vis-remote-home: '
        echo "-- .exit cua 'true' va 'false' (doc tu TEP, khong qua Powershell) --"
        run_once "$host" "${log%.log}-true.log" "$stem-true" true >/dev/null 2>&1 || true
        e_true="$VR_EXIT"
        run_once "$host" "${log%.log}-false.log" "$stem-false" false >/dev/null 2>&1 || true
        e_false="$VR_EXIT"
        printf 'true  .exit=%s (cho 0)  %s\n' "$e_true" "$([ "$e_true" = 0 ] && echo OK || echo SAI)"
        printf 'false .exit=%s (cho 1)  %s\n' "$e_false" "$([ "$e_false" = 1 ] && echo OK || echo SAI)"
        printf 'log: %s-true.log · %s-false.log\n' "${log%.log}" "${log%.log}"
        printf 'home_may_dich=%s\n' "$rhome"
        [ "$e_true" = 0 ] && [ "$e_false" = 1 ] && ok=1
        [ "$ok" = 1 ] || { say "--check LỆCH (.exit của true/false không đúng)"; exit 5; }
        say "--check OK"
        exit 0
    fi

    [ $# -gt 0 ] || die 2 "thiếu lệnh — dùng: bin/vis-remote $host -- <lệnh…>"
    run_once "$host" "$log" "$stem" "$@"
    exit "$VR_EXIT"
}

VR_EXIT=0
DIRTY_POLICY="skip"   # ST-175: `check` = từ chối cây bẩn; `skip` = bỏ kiểm (xem default_dirty_policy)
main "$@"

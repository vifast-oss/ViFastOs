#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# vis-lock — giu khoa may do thoi gian `~/.vifast-measure.lock` trong suot mot lenh (ST-176, VD-177 §3).
#
# Vi sao: macOS KHONG co lenh `flock` (da kiem `command -v flock` = rong tren may do), nen giao thuc
#   `flock "$HOME/.vifast-measure.lock" -c '<lenh do>'` trong `agent/JOURNAL/khoa-may-do-luong.md`
#   khong chay duoc tren mac. Cong cu nay thay bang `fcntl.flock(LOCK_EX)` cua python3, giu khoa
#   tu luc lay duoc den khi tien trinh con thoat, va in bang chung ra stderr + (tuy chon) vao log do.
#
# Dung:
#   bin/vis-lock [--timeout <giay>] [--log <tep>] -- <lenh> [doi so…]
#   bin/vis-lock -h | --help
#
#   --timeout <giay>  cho khoa toi da <giay>; HET THOI GIAN => exit 124, lenh KHONG chay.
#                     Khong co co nay (hoac 0) => cho vo han.
#   --log <tep>       ghi tiep (append) cac dong `# ST-176 vis-lock …` vao <tep>: mot dong luc
#                     LAY DUOC KHOA (co `load_truoc`) va mot dong luc KET THUC (co `load_sau`,
#                     `ma_ra`, `giay`). Tep chua co => tao; KHONG bao gio truncate.
#
# Bien moi truong:
#   VIS_LOCK_FILE   duong khoa (mac dinh `~/.vifast-measure.lock`).
#
# In ra stderr: `lock=yes pid=<pid> tep=<duong khoa> cho=<giay>` ngay sau khi lay duoc khoa,
#   va `lock=no pid=… ma_ra=… giay=…` khi lenh xong. Dong log tuong ung co du `load_truoc`/`load_sau`
#   (mac: `sysctl -n vm.loadavg`; Linux: `/proc/loadavg`).
#
# Ma thoat: N = ma thoat that cua lenh (0..255) · 2 dung sai · 3 khong mo duoc tep khoa / khong co
#   python3 · 124 het thoi gian cho khoa (lenh khong chay).
#
# Vi du:
#   bin/vis-lock -- env VIS_TASK_ID=176 bin/vis-soak --log "$PWD/agent/JOURNAL/st176-soak-macos.log" --append
#   bin/vis-lock --timeout 60 --log /tmp/do.log -- sh -c 'time cargo test -p vis-interp'
set -u

usage() {
    cat >&2 <<'USAGE'
dung: bin/vis-lock [--timeout <giay>] [--log <tep>] -- <lenh> [doi so…]

  --timeout <giay>  cho khoa toi da <giay>; het thoi gian => exit 124, lenh KHONG chay
                    (khong co co nay hoac 0 => cho vo han)
  --log <tep>       ghi tiep cac dong "# ST-176 vis-lock …" (load_truoc luc lay khoa,
                    load_sau + ma_ra + giay luc xong) vao <tep>; KHONG truncate
  VIS_LOCK_FILE     duong khoa (mac dinh ~/.vifast-measure.lock)
USAGE
    exit 2
}

TIMEOUT=0
LOCKLOG=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            ;;
        --timeout)
            shift
            if [ $# -eq 0 ]; then
                echo "vis-lock: --timeout can <giay>" >&2
                exit 2
            fi
            TIMEOUT=$1
            ;;
        --timeout=*)
            TIMEOUT=${1#--timeout=}
            ;;
        --log)
            shift
            if [ $# -eq 0 ] || [ -z "$1" ]; then
                echo "vis-lock: --log can <tep>" >&2
                exit 2
            fi
            LOCKLOG=$1
            ;;
        --log=*)
            LOCKLOG=${1#--log=}
            if [ -z "$LOCKLOG" ]; then
                echo "vis-lock: --log can <tep>" >&2
                exit 2
            fi
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "vis-lock: thieu '--' truoc lenh (gap '$1')" >&2
            usage
            ;;
    esac
    shift
done
if [ $# -eq 0 ]; then
    echo "vis-lock: thieu lenh sau '--'" >&2
    usage
fi
case "$TIMEOUT" in
    '' | *[!0-9]*)
        echo "vis-lock: --timeout can so giay nguyen (nhan '$TIMEOUT')" >&2
        exit 2
        ;;
esac

PY=""
for c in python3.12 python3.11 python3; do
    if command -v "$c" >/dev/null 2>&1; then
        PY=$c
        break
    fi
done
if [ -z "$PY" ]; then
    echo "vis-lock: khong thay python3 — khong lay duoc khoa (BLOCKED-ENV)" >&2
    exit 3
fi

# Thong diep tieng Viet ra stderr: ep UTF-8 de khong phu thuoc locale cua phien background.
PYCODE=$(
    cat <<'PY'
import errno, fcntl, os, platform, subprocess, sys, time


def msg(s):
    sys.stderr.write("vis-lock: " + s + "\n")
    sys.stderr.flush()


def append_log(path, line):
    if not path:
        return
    try:
        with open(path, "a") as f:
            f.write(line + "\n")
    except OSError as e:
        msg("KHONG ghi duoc log khoa '%s': %s" % (path, e))


def load():
    """Load trung binh 1/5/15 phut (mac: sysctl vm.loadavg; Linux: /proc/loadavg)."""
    try:
        if os.path.exists("/proc/loadavg"):
            with open("/proc/loadavg") as f:
                return f.read().strip()
        out = subprocess.run(
            ["sysctl", "-n", "vm.loadavg"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        return out.stdout.decode("utf-8", "replace").strip()
    except Exception as e:  # chi de log, khong lam hong phep do
        return "? (%s)" % e


def main(argv):
    timeout = int(argv[0])
    logfile = argv[1] if len(argv) > 1 else ""
    cmd = argv[2:]
    if not cmd:
        msg("thieu lenh")
        return 2
    path = os.path.expanduser(os.environ.get("VIS_LOCK_FILE") or "~/.vifast-measure.lock")
    pid = os.getpid()
    host = platform.node()
    try:
        fh = open(path, "a+")
    except OSError as e:
        msg("KHONG mo duoc tep khoa '%s': %s (BLOCKED-ENV)" % (path, e))
        return 3
    t0 = time.monotonic()
    da_cho = False
    while True:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError as e:
            if e.errno not in (errno.EACCES, errno.EAGAIN, errno.EWOULDBLOCK):
                msg("loi fcntl.flock: %s (BLOCKED-ENV)" % e)
                return 3
            if not da_cho:
                msg(
                    "khoa '%s' dang bi giu — cho%s"
                    % (path, "" if timeout <= 0 else " (toi da %ds)" % timeout)
                )
                da_cho = True
            if timeout > 0 and time.monotonic() - t0 >= timeout:
                msg("HET THOI GIAN cho khoa sau %ds — lenh KHONG chay (exit 124)" % timeout)
                append_log(
                    logfile,
                    '# ST-176 vis-lock lock=no host=%s pid=%d tep=%s ma_ra=124 '
                    'ket_luan="het thoi gian cho khoa" load="%s"'
                    % (host, pid, path, load()),
                )
                return 124
            time.sleep(0.2)
    cho = time.monotonic() - t0
    dong = "lock=yes pid=%d tep=%s cho=%.1fs" % (pid, path, cho)
    msg(dong)
    append_log(
        logfile,
        '# ST-176 vis-lock %s host=%s lenh="%s" load_truoc="%s" thoi_diem="%s"'
        % (
            dong,
            host,
            " ".join(cmd),
            load(),
            time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        ),
    )
    t1 = time.monotonic()
    ma = 0
    try:
        ma = subprocess.call(cmd)
    except OSError as e:
        msg("khong chay duoc lenh: %s" % e)
        ma = 127
    except KeyboardInterrupt:
        msg("bi ngat (SIGINT) — khoa giu toi khi tien trinh thoat")
        ma = 130
    giay = time.monotonic() - t1
    msg("lock=no pid=%d ma_ra=%d giay=%.1fs" % (pid, ma, giay))
    append_log(
        logfile,
        '# ST-176 vis-lock lock=yes pid=%d (giu suot lenh) ma_ra=%d giay=%.1f load_sau="%s" '
        'thoi_diem="%s"'
        % (pid, ma, giay, load(), time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())),
    )
    return ma & 0xFF


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
PY
)

PYTHONIOENCODING=utf-8
export PYTHONIOENCODING
exec "$PY" -c "$PYCODE" "$TIMEOUT" "$LOCKLOG" "$@"

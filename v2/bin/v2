#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# v2/bin/v2 — cổng của dòng OS v2 (KT-03).
#
# **KT-333d (D2-245)** — **dispatcher mỏng**: toàn bộ thân lệnh nằm trong `v2/bin/lib/*.sh`
# (`consts`, `util`, `lock`, `lane`, `steps_check`, `steps_gate`, `steps_nightly`, `steps_soak`,
# `nightly`, `check`, `gate`, `t0`, `selftests`, `help`). Tệp này chỉ: (1) tính gốc repo, (2) nạp
# khoá máy đo + thư viện, (3) `exec`/gọi đúng lệnh. Lý do tách: trước đây 2.185 dòng và **mọi**
# task đều sửa cùng một tệp ⇒ xung đột merge liên tục (D2-245/D2-248).
#
# **Bất biến của lần tách**: cùng lệnh, cùng **45 + 31 bước**, cùng id, cùng làn, cùng ngưỡng,
# cùng mã thoát. Bằng chứng: `# gate-steps registered=45 ran=45 skipped=0 failed=0` trước/sau
# (xem `v2/agent/JOURNAL/kt333d-v2lib.md`).
#
# Vòng 1: fmt, clippy -D warnings, 5 luật cấu trúc (R1..R5), ABI/scn/report checks, L0, L1 1.000 seed.
# gen-check đã bật (KT-05); Miri có lệnh rời `v2 miri` (KT-13) và `nightly --only-miri` (KT-17, D2-47(a));
# **KT-333b**: `v2 nightly` đầy đủ (--all: L1-full hợp đồng K6 + Miri + đột biến + soak; --status;
# --dry-run; --selftest) + `v2 licenses` (D2-21: deny.toml allowlist QD §9.3, THIRD-PARTY.md máy sinh).
# **KT-333d**: `v2 t0` (T0 nhanh — KHÔNG phải cổng) + khoá 2 lớp T0/T1/T2 (D2-248).
# Mọi lệnh cargo dùng `--manifest-path v2/Cargo.toml`: KHÔNG bao giờ chạm workspace v1
# (crates/, 25 crate đã đóng băng ở tag v1-archive).
set -u

V2_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$V2_ROOT/.." && pwd)"
MANIFEST="$V2_ROOT/Cargo.toml"
export V2_ROOT REPO_ROOT MANIFEST

# **KT-333c (D2-243 mục 3a)** — khoá độc quyền **cấp máy đo** (`v2/tools/measure-lock.sh`).
# Hai `gate --fast` song song ngày 2026-11-22 làm git-guard tranh `.git`, QEMU chồng tải và một số
# đo "−43,9 %" phải vô hiệu ⇒ `gate --fast`/`nightly`/`soak*.sh` **fail-closed** khi đã có tiến
# trình khác giữ khoá. `gate --dev` (T1) và `v2 t0` **không** giành khoá — chỉ đọc trạng thái bằng
# `measure_lock_is_held` (khoá 2 lớp, D2-248). Cờ thoát hiểm `V2_MEASURE_LOCK=off` in cảnh báo to
# (chỉ dùng máy khác).
# shellcheck source=/dev/null
. "$V2_ROOT/tools/measure-lock.sh"

# Thư viện của cổng. Nạp **trước** phần dispatch; thứ tự dưới đây là thứ tự đọc (mọi hàm chỉ
# resolve lúc gọi nên thứ tự không tạo phụ thuộc ẩn).
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/consts.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/util.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/lock.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/lane.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/steps_check.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/steps_gate.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/steps_nightly.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/steps_soak.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/nightly.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/check.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/gate.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/t0.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/selftests.sh"
# shellcheck source=/dev/null
. "$V2_ROOT/bin/lib/help.sh"

# ---------------------------------------------------------------- dispatch (KT-333d)
#
# Mỗi nhánh chỉ gọi **một** hàm của thư viện; không chứa thân lệnh. `v2 t0` là lệnh **T0** —
# không phải cổng (in rõ nhãn, xem `lib/t0.sh`).
rc=0
cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    sim)
        exec "$CARGO" run -q --manifest-path "$V2_ROOT/Cargo.toml" -p vifast-sim -- "$@"
        ;;
    agentctl)
        exec "$CARGO" run -q --manifest-path "$V2_ROOT/Cargo.toml" -p vifast-agentctl -- "$@"
        ;;
    check)
        rc=0
        do_check || rc=1
        lane_report
        gate_summary "check" "$LANE_T0"
        exit "$rc"
        ;;
    gate)
        rc=0
        if [ "${1:-}" = "--fast" ]; then
            do_gate_fast || rc=1
            lane_report
            gate_summary "gate --fast (T2)" "$LANE_T0"
            if [ "$rc" -eq 0 ]; then
                echo "v2 gate --fast: PASS (gen-check ON từ KT-05; L1 sim 1.000 seed)"
            else
                echo "v2 gate --fast: FAIL" >&2
            fi
        elif [ "${1:-}" = "--dev" ]; then
            do_gate_dev || rc=1
            lane_report
            gate_summary "gate --dev (T1)" "$LANE_T0"
            if [ "$rc" -eq 0 ]; then
                echo "v2 gate --dev: PASS (T1 — kiểm tích hợp nhanh, **KHÔNG** phải full gate; full gate = 'gate --fast')"
            else
                echo "v2 gate --dev: FAIL (T1 — kiểm tích hợp nhanh)" >&2
            fi
        else
            echo "v2: cổng đầy đủ CHƯA CÓ trong vòng 1 — chỉ dùng 'gate --fast' (AGENTS.md §6)" >&2
            exit 2
        fi
        exit "$rc"
        ;;
    nightly) do_nightly "$@" ;;
    miri) do_miri "$@" ;;
    t0) t0_main "$@" ;;
    licenses)
        # KT-333b (D2-21): allowlist QD §9.3 + THIRD-PARTY.md sinh tự động (không NOTICE).
        lp="$(find_python)" || {
            echo "v2 licenses: cần python ≥3.11 có tomllib (đã thử python3.12/3.11/3)" >&2
            exit 2
        }
        case "${1:-}" in
            ""|--check) exec "$lp" "$V2_ROOT/tools/check-licenses.py" --root "$REPO_ROOT" --check ;;
            --generate) exec "$lp" "$V2_ROOT/tools/check-licenses.py" --root "$REPO_ROOT" --generate ;;
            --selftest) exec "$lp" "$V2_ROOT/tools/check-licenses.py" --selftest ;;
            *) echo "v2 licenses: nhận --check | --generate | --selftest" >&2; exit 2 ;;
        esac
        ;;
    status) exec bash "$V2_ROOT/tools/status.sh" "$@" ;;
    check-repro) exec bash "$V2_ROOT/tools/repro-check.sh" "$@" ;;
    check-rules) check_k6_rules "$@" ;;
    rules)
        root="$V2_ROOT"
        if [ "${1:-}" = "--root" ] && [ -n "${2:-}" ]; then
            root="$2"
        elif [ -n "${1:-}" ]; then
            echo "v2: 'rules' chỉ nhận --root <thư mục>" >&2
            exit 2
        fi
        if [ ! -d "$root" ]; then
            echo "v2: không có thư mục $root" >&2
            exit 2
        fi
        if rules "$root"; then
            echo "rules: PASS ($root)"
            exit 0
        fi
        echo "rules: FAIL ($root)" >&2
        exit 1
        ;;
    "" | -h | --help | help) usage ;;
    *)
        echo "v2: lệnh không biết: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac

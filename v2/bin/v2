#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# v2/bin/v2 — cổng của dòng OS v2 (KT-03).
#
# Vòng 1: fmt, clippy -D warnings, 5 luật cấu trúc (R1..R5), ABI/scn/report checks, L0, L1 1.000 seed.
# gen-check đã bật (KT-05); Miri có lệnh rời `v2 miri` (KT-13) và `nightly --only-miri` (KT-17, D2-47(a));
# nightly đầy đủ (L1 100k/mutation/soak) vẫn CHƯA CÓ — AGENTS.md §6.
# Mọi lệnh cargo dùng `--manifest-path v2/Cargo.toml`: KHÔNG bao giờ chạm workspace v1
# (crates/, 25 crate đã đóng băng ở tag v1-archive).
set -u

V2_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$V2_ROOT/.." && pwd)"
MANIFEST="$V2_ROOT/Cargo.toml"

# cargo có thể không nằm trên PATH (máy này: ~/.cargo/bin).
find_cargo() {
    if command -v cargo >/dev/null 2>&1; then
        command -v cargo
        return 0
    fi
    local c
    for c in "$HOME/.cargo/bin/cargo" "/usr/local/cargo/bin/cargo" "/opt/homebrew/bin/cargo"; do
        if [ -x "$c" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

CARGO="$(find_cargo)" || {
    echo "v2: không tìm thấy cargo (đã thử PATH, ~/.cargo/bin, /usr/local/cargo/bin, /opt/homebrew/bin)" >&2
    exit 127
}
export PATH="$(dirname "$CARGO"):$PATH"

# **KT-190** (T-INFRA 2026-11-19): ghim toolchain theo `v2/rust-toolchain.toml` cho **mọi** lệnh
# cargo của script. Trước đây script dựa vào toolchain **mặc định của máy**; khi rustup nâng
# stable 1.99.1 → 1.100.0, clippy bắt 13 lint `needless_range_loop` mới trong `vifast-fs`/
# `vifast-alloc` (mã **không đổi**) ⇒ cổng đỏ oan, và ảnh build có thể lệch toolchain so với
# `repro-build.sh` (vốn gọi `cargo +1.99.1`). Ghim để cổng + ảnh không phụ thuộc máy.
if [ -z "${RUSTUP_TOOLCHAIN:-}" ] && [ -f "$V2_ROOT/rust-toolchain.toml" ]; then
    _v2_tc="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' "$V2_ROOT/rust-toolchain.toml" | head -1)"
    if [ -n "$_v2_tc" ]; then
        export RUSTUP_TOOLCHAIN="$_v2_tc"
    fi
fi

# rustup có thể không nằm trên PATH (máy này: ~/.cargo/bin) — cùng cách tìm như cargo.
find_rustup() {
    if command -v rustup >/dev/null 2>&1; then
        command -v rustup
        return 0
    fi
    local c
    for c in "$HOME/.cargo/bin/rustup" "/usr/local/cargo/bin/rustup" "/opt/homebrew/bin/rustup"; do
        if [ -x "$c" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

find_python() {
    local c
    for c in python3.12 python3.11 python3; do
        if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import tomllib' >/dev/null 2>&1; then
            command -v "$c"
            return 0
        fi
    done
    return 1
}

usage() {
    cat <<'EOF'
v2 — cổng dòng OS ViFastOs v2 (vòng 1)

  ./v2/bin/v2 check            fmt + clippy + 5 luật cấu trúc + self-test luật + build
  ./v2/bin/v2 gate --fast      như check + L0 (cargo test --workspace). BẮT BUỘC cuối mỗi task
  ./v2/bin/v2 gate             CHƯA CÓ trong vòng 1 (cần L2/L3)
  ./v2/bin/v2 nightly --only-miri
                               CHỈ Miri trên tập chọn (KT-17, D2-47(a) + KT-23): vifast-objmem
                               (toàn bộ) + sim (--lib, kt16_objmem, kt09_untyped, kt09_revoke,
                               kt10_cnode, kt17_align, kt18_tcb, kt19_sched, kt20_budget,
                               kt21_donation, kt22_mailbox). KHÔNG L1 100k/mutation/soak
  ./v2/bin/v2 nightly --l1 [--seeds N] [--smp a,b,c]
                               L1 theo smp (KT-29): mặc định 10.000 seed × smp 1,2,4,8;
                               cùng seed ⇒ cùng trace. 100k seed thuộc cổng cuối phase §7.1.
  ./v2/bin/v2 nightly          CHƯA CÓ cho nightly đầy đủ (L1 100k/mutation/soak) — có
                               `--only-miri` và `--l1`
  ./v2/bin/v2 miri [test|run|setup|clean] [tuỳ chọn]
                               Miri qua `cargo +nightly miri` trên v2/Cargo.toml; mặc định `test`
                               (D2-47: lệnh rời, KHÔNG nằm trong gate --fast)
  ./v2/bin/v2 rules [--root D] chỉ chạy 5 luật cấu trúc trên D (mặc định v2/)
  ./v2/bin/v2 check-rules [--law N] [--self-test] [--root R]
                               KT-80 / OD-K6-5: 5 luật máy (1, 2, 3, 7, 8) — số do script sinh từ
                               log đã commit; log commit trước báo cáo; bộ đếm "0" phải có ca âm;
                               bản trích tiêu chí đủ cột; ca phá cũ là ca hồi quy. Được
                               `v2 check` / `gate --fast` gọi tự động.
  ./v2/bin/v2 status [--json]
                               KT-102: một màn hình trạng thái (HEAD, dấu vân tay build-inputs,
                               ảnh mới nhất, đếm task). Chỉ đọc, không build.
  ./v2/bin/v2 check-repro [--negative]
                               KT-79 / OD-K6-3: build ảnh sản phẩm ở **2 đường dẫn tuyệt đối
                               khác nhau** ⇒ phải CÙNG sha256. `--negative` = ca âm (tắt
                               --remap-path-prefix) ⇒ phải ĐỎ. KHÔNG nằm trong gate --fast
                               (2 build lạnh ~2 phút); xem v2/docs/k6-repro.md

Luật: R1 tệp kernel/lib ≤1.500 dòng; R2 cấm cfg(target_arch) trong kernel/vifast-core + lib;
      R3 SPDX theo loại tệp; R4 cấm path-dependency sang crates/ (D2-26);
      R5 unsafe chỉ trong danh sách đóng (D2-17).
L1 đã bật từ KT-08: 1.000 seed trong `gate --fast`; nightly 100.000 seed + mutation/soak vẫn chưa có
(`nightly --only-miri` chỉ chạy Miri — D2-47(a); `nightly --l1` chạy driver L1 theo smp — KT-29).
Bootstrap Miri (khi `v2 miri` báo thiếu toolchain): rustup component add miri rust-src --toolchain nightly
EOF
}

# ---------------------------------------------------------------- luật cấu trúc

# Tập thư mục được quét (thiết kế §8). Fixture của self-test nằm ở v2/test/rules nên
# không tự quét chính nó; `target/` luôn bị bỏ.
SCAN_DIRS="kernel lib sim user std boot test tools"

# rules <root>: in vi phạm "R<k> <đường dẫn>[:dòng]: <lý do>", trả 0 nếu sạch.
relpath() {
    case "$1" in
        "$REPO_ROOT"/*) printf '%s' "${1#"$REPO_ROOT"/}" ;;
        *) printf '%s' "${1#"$2"/}" ;;
    esac
}

rules() {
    local root found=0 dirs=() d f n line path
    root="$(cd "$1" 2>/dev/null && pwd)" || {
        echo "rules: không có thư mục $1" >&2
        return 1
    }
    # Fixture cố ý vi phạm nằm ở v2/test/fixtures — chỉ loại khi quét chính cây v2.
    local EXCL=(-not -path '/__khong_ton_tai__/*')
    if [ "$root" = "$V2_ROOT" ]; then
        EXCL=(-not -path "$V2_ROOT/test/fixtures/*")
    fi
    for d in $SCAN_DIRS; do
        [ -d "$root/$d" ] && dirs+=("$root/$d")
    done
    if [ "$root" = "$V2_ROOT" ] && [ -d "$REPO_ROOT/spec" ]; then
        dirs+=("$REPO_ROOT/spec")
    fi
    if [ "${#dirs[@]}" -eq 0 ]; then
        echo "rules: không có thư mục nào trong ($SCAN_DIRS) dưới $root" >&2
        return 1
    fi

    # R1: tệp trong kernel/ và lib/ không quá 1.500 dòng [TK]
    for d in kernel lib; do
        [ -d "$root/$d" ] || continue
        while IFS= read -r -d '' f; do
            n=$(wc -l <"$f" | tr -d ' ')
            if [ "$n" -gt 1500 ]; then
                echo "R1 $(relpath "$f" "$root"): $n dòng > 1500"
                found=1
            fi
        done < <(find "$root/$d" -type f \( -name '*.rs' -o -name '*.s' -o -name '*.asm' \) \
            -not -path '*/target/*' "${EXCL[@]}" -print0 2>/dev/null)
    done

    # R2: cấm cfg(target_arch) trong kernel/vifast-core và lib/ (thiết kế §8)
    for d in "$root/kernel/vifast-core" "$root/lib"; do
        [ -d "$d" ] || continue
        while IFS= read -r line; do
            echo "R2 ${line#"$root"/}"
            found=1
        done < <(grep -rn --include='*.rs' 'cfg(target_arch' "$d" 2>/dev/null)
    done

    # R3: SPDX theo loại tệp (QD §9.3)
    for d in "${dirs[@]}"; do
        while IFS= read -r -d '' f; do
            case "$f" in
                *.rs | *.s | *.asm | *.ld | *.toml | *.vis | *.vish | *.vidl | *.sh | *.py)
                    if ! head -5 "$f" | grep -q 'SPDX-License-Identifier'; then
                        echo "R3 $(relpath "$f" "$root"): thiếu SPDX-License-Identifier trong 5 dòng đầu"
                        found=1
                    fi
                    ;;
                *.json | *.bin | *.txt)
                    if [ ! -f "$f.license" ]; then
                        echo "R3 $(relpath "$f" "$root"): tệp không có cú pháp chú thích cần sidecar .license"
                        found=1
                    fi
                    ;;
            esac
        done < <(find "$d" -type f -not -path '*/target/*' "${EXCL[@]}" -print0 2>/dev/null)
    done

    # R4: cấm path-dependency sang crates/ — v1 đã đóng băng (D2-26)
    for d in "${dirs[@]}"; do
        while IFS= read -r -d '' f; do
            n=0
            while IFS= read -r line; do
                n=$((n + 1))
                echo "R4 $(relpath "$f" "$root"):$n: path-dependency sang crates/ ($line)"
                found=1
            done < <(grep -nE 'path[[:space:]]*=[[:space:]]*"[^"]*crates/' "$f" 2>/dev/null)
        done < <(find "$d" -name Cargo.toml -not -path '*/target/*' "${EXCL[@]}" -print0 2>/dev/null)
    done

    # R5: unsafe chỉ trong danh sách đóng (D2-17): vifast-sync, vifast-objmem,
    #     kernel/vifast-plat-*, boot/
    for d in "${dirs[@]}"; do
        while IFS= read -r -d '' f; do
            path="$(relpath "$f" "$root")"
            case "$f" in
                "$root"/boot/* | "$root"/kernel/vifast-plat-* | *vifast-sync* | *vifast-objmem*) continue ;;
            esac
            while IFS= read -r line; do
                echo "R5 $line"
                found=1
            done < <(grep -nE '\bunsafe[[:space:]]*(fn|impl|trait|extern|\{)' "$f" 2>/dev/null |
                sed "s|^|$path:|")
        done < <(find "$d" -name '*.rs' -not -path '*/target/*' "${EXCL[@]}" -print0 2>/dev/null)
    done

    return "$found"
}

# ---------------------------------------------------------------- các lệnh

run_step() { # <tên> <lệnh...>
    local name="$1"
    shift
    echo "--- $name"
    if "$@"; then
        echo "--- $name: OK"
        return 0
    fi
    echo "--- $name: FAIL" >&2
    return 1
}

# KT-80 / OD-K6-5 — 5 luật máy; logic nằm ở `v2/tools/verify-numbers.py` (một công cụ dùng
# chung, không copy-paste 4 verifier cũ). `--law`/`--self-test`/`--root` chuyển tiếp nguyên văn.
check_k6_rules() {
    local py
    if ! py="$(find_python)"; then
        echo "check-rules: cần python ≥ 3.11 có tomllib (đã thử python3.12/3.11/3)" >&2
        return 1
    fi
    "$py" "$V2_ROOT/tools/verify-numbers.py" --root "$REPO_ROOT" "$@"
}

do_check() {
    local fails=0
    echo "== v2 check (HEAD $(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')) =="
    run_step "fmt" "$CARGO" fmt --all --check --manifest-path "$MANIFEST" || fails=$((fails + 1))
    run_step "clippy" "$CARGO" clippy --manifest-path "$MANIFEST" --workspace --all-targets -- -D warnings || fails=$((fails + 1))
    echo "--- luật cấu trúc R1..R5"
    # **KT-155 (T-INFRA)** — bash 3.2 (macOS) bị hỏng heap (`BUG IN CLIENT OF LIBMALLOC:
    # memory corruption of free block`, SIGTRAP) sau khi `rules` quét cây lớn; heap hỏng bị
    # các tiến trình con kế thừa ⇒ bước sau đỏ oan (exit 133).
    # **KT-207 (T-INFRA, 2026-11-20)** — workaround **subshell** của KT-155 **không đủ**: hai
    # reviewer độc lập (L41/L42) vẫn đỏ ngay **bước `rules`** (`Trace/BPT trap: 5`), vì subshell
    # `( … )` là **fork** — nó **thừa hưởng** heap đã hỏng của tiến trình cha (sau `clippy`).
    # Nay chạy `rules` trong **tiến trình bash mới** qua chính lệnh con `v2 rules --root`:
    # heap sạch, không thừa hưởng hỏng hóc. Cùng output, cùng mã thoát, cùng ngữ nghĩa.
    # Bằng chứng: `v2/agent/JOURNAL/kt207-logs/` (trước: SIGTRAP ở `rules`; sau: 5/5 lượt
    # `v2 check` xanh dưới tải 3 sub-agent). Không phải nới ngưỡng.
    if bash "$V2_ROOT/bin/v2" rules --root "$V2_ROOT"; then echo "--- luật cấu trúc: OK"; else echo "--- luật cấu trúc: FAIL" >&2; fails=$((fails + 1)); fi
    run_step "self-test luật" bash "$V2_ROOT/test/rules/run.sh" || fails=$((fails + 1))
    run_step "luật máy K6 (KT-80: 1,2,3,7,8)" check_k6_rules || fails=$((fails + 1))
    # KT-128 (Q3 của Agent 0): ca hồi quy của **cổng build-inputs** phải chạy trong cổng, không
    # chỉ nằm trong tệp. Trước đây `build-rev.sh --selftest` ĐỎ âm thầm vì không cổng nào gọi nó.
    run_step "selftest build-inputs (KT-128/134: a..h)" bash "$V2_ROOT/test/boot/build-rev.sh" --selftest || fails=$((fails + 1))
    # **KT-145 (Agent 0 phiếu lượt 5 §A4)**: cổng **danh tính ảnh** (`vbrev_image_identity`) — năm
    # ca l1..l5, có **đối chứng dương** (l3) để một hàm luôn-từ-chối không qua được. Tách khỏi
    # `build-rev.sh` để định nghĩa dấu vân tay không phải tăng `VBREV_ALGO` vì một hàm tiêu thụ.
    run_step "selftest danh tính ảnh (KT-145: l1..l5)" bash "$V2_ROOT/test/boot/build-identity.sh" --selftest || fails=$((fails + 1))
    # **KT-149 (D2-129)**: harness T26 (`t26.sh`) có `--selftest` ca âm — log đỏ giả phải bị bắt
    # đỏ, log xanh giả phải được nhận xanh. Nối vào `check` (nhóm nhanh, không cần QEMU/ảnh) để
    # không lặp lại lớp lỗi "selftest không cổng nào gọi" (KT-134).
    run_step "selftest t26 (KT-149: g1..g4)" bash "$V2_ROOT/test/boot/t26.sh" --selftest || fails=$((fails + 1))
    # **KT-134 (C1 của Agent 0)**: `build-rev.sh` đã ra khỏi danh sách ghim, nên đổi **thuật toán**
    # mà quên tăng `VBREV_ALGO` sẽ không ai phát hiện. Tệp ghim giữ cặp (sha script, giá trị algo);
    # `--strict` để ghim cũ (đã tăng algo nhưng quên `--update`) cũng là ĐỎ — nếu không, cơ chế chỉ
    # bắt được lần vi phạm **đầu tiên** rồi xanh vĩnh viễn.
    run_step "ghim thuật toán dấu vân tay (KT-134)" bash "$V2_ROOT/tools/check-algo-pin.sh" --strict || fails=$((fails + 1))
    run_step "selftest ghim thuật toán (KT-134)" bash "$V2_ROOT/tools/check-algo-pin.sh" --selftest || fails=$((fails + 1))
    # **KT-134 (Agent 0, phần 3)**: rà lại thì **chín** selftest khác cũng không cổng nào gọi —
    # cùng lớp lỗi đã làm `build-rev.sh --selftest` đỏ âm thầm. Nay gọi hết; nhóm nhanh ở đây,
    # nhóm chậm (cần QEMU/dựng ảnh) ở `gate --fast` qua `selftest_all`.
    run_step "selftest shell-edge (KT-108)" bash "$V2_ROOT/test/boot/shell-edge.sh" --selftest || fails=$((fails + 1))
    run_step "selftest budget (KT-88)" bash "$V2_ROOT/test/boot/budget.sh" --selftest || fails=$((fails + 1))
    run_step "selftest counter-evidence (KT-80)" bash "$V2_ROOT/test/rules/counter-evidence.sh" --selftest || fails=$((fails + 1))
    run_step "selftest task-target (KT-84)" bash "$V2_ROOT/tools/task-target.sh" --selftest || fails=$((fails + 1))
    # **KT-134 (C7 của Agent 0)**: bảng đối chiếu số ↔ khối `scope=` phải được **kiểm máy** —
    # đọc bảng, mở đúng khối, so giá trị với dòng log. Không có kiểm máy thì Q6 chưa xong.
    if PY="$(find_python)"; then
        run_step "bảng đối chiếu số ↔ khối scope= (KT-134)" "$PY" "$V2_ROOT/tools/check-scope-table.py" --root "$REPO_ROOT" || fails=$((fails + 1))
        run_step "selftest bảng đối chiếu (KT-134)" "$PY" "$V2_ROOT/tools/check-scope-table.py" --selftest || fails=$((fails + 1))
        # **KT-134 (Agent 0, phần 3)**: chống tái diễn lớp lỗi "selftest không cổng nào gọi".
        # Quét repo tìm mọi script tự kiểm; script nào không cổng nào gọi ⇒ ĐỎ. Công cụ này cũng
        # bắt được ca "cổng truyền cờ mà script không xử lý cờ" (đã xảy ra thật với
        # `counter-evidence.sh` — bước cổng mang nhãn selftest mà không kiểm gì).
        run_step "selftest wiring (KT-134)" "$PY" "$V2_ROOT/tools/check-selftest-wiring.py" --selftest || fails=$((fails + 1))
        # **KT-139 (Agent 0)**: bật `--standalone-red` **vĩnh viễn**. Vì sao: công cụ này có **hai**
        # lớp — lớp có cờ (`--selftest`/`--red-selftest`) vốn đã đỏ khi mồ côi, còn lớp **độc lập**
        # (không cờ, nhận theo tên tệp: `selfbreak.sh`, `neg-test*.sh`) trước đây **chỉ được báo
        # cáo**, nên ba script mồ côi nằm im mà cổng vẫn xanh. Nay cả ba đã được nối vào
        # `gate --fast`; bật cờ để **script thứ tư** rơi vào lớp này là ĐỎ ngay, không chờ ai rà tay.
        # Không thêm ngoại lệ nào: một ngoại lệ = miễn trừ phép kiểm = lại để lỗ mục âm thầm.
        run_step "cổng selftest có cổng gọi (KT-134)" "$PY" "$V2_ROOT/tools/check-selftest-wiring.py" --standalone-red || fails=$((fails + 1))
        # **KT-151 (N7, D2-131)** — máy kiểm "một cơ chế đánh thức TCB": quét `v2/kernel` +
        # `v2/sim`, đòi kênh chéo hart là hộp thư duy nhất, không doorbell riêng theo arch.
        # Fail-closed: thiếu mỏ neo (`wake_step`/`apply_mail`/`MailboxMsg`/`Msg`) ⇒ ĐỎ.
        run_step "wake paths (KT-151: một cơ chế wake)" "$PY" "$V2_ROOT/tools/check-wake-paths.py" || fails=$((fails + 1))
        run_step "selftest wake paths (KT-151)" "$PY" "$V2_ROOT/tools/check-wake-paths.py" --selftest || fails=$((fails + 1))
        # **KT-155 (N7-2b)** — `--strict` vào cổng: **allowlist tường minh** thay heuristic
        # "thân hàm có `is_blocked()`/`Sleeping`" (heuristic chỉ phủ 4/16 đường — KT-154 §7).
        # Mọi `transition_tcb(…, TcbState::Ready)` phải qua cửa `wake_step`/`wake_from` hoặc
        # có tên trong allowlist kèm lý do; chỗ lạ ⇒ ĐỎ (fail-closed hai chiều). Đây là
        # **thêm phép đo**, không nới ngưỡng nào.
        run_step "wake paths --strict (KT-155: allowlist)" "$PY" "$V2_ROOT/tools/check-wake-paths.py" --strict || fails=$((fails + 1))
        # **KT-163 (N7, D2-137)** — máy kiểm "test có răng": chống lớp lỗi **xanh-giả** đã
        # xảy ra hơn mười lần (gần nhất N7 suýt đóng sai). Bốn lớp **chắc chắn**, không
        # heuristic mờ: (a) `assert!(true)` / `assert_eq!(x, x)` hằng-đúng; (b) `#[ignore]`;
        # (c) `#[test]` không có token khẳng định nào và không gọi trợ giúp đã biết;
        # (d) `let _ =` nuốt `Result` (tra bảng chữ ký dựng từ chính cây nguồn).
        # Fail-closed: mục mới không có trong allowlist ⇒ ĐỎ; mục allowlist chết ⇒ ĐỎ.
        run_step "test có răng (KT-163)" "$PY" "$V2_ROOT/tools/check-test-teeth.py" || fails=$((fails + 1))
        run_step "selftest test có răng (KT-163)" "$PY" "$V2_ROOT/tools/check-test-teeth.py" --selftest || fails=$((fails + 1))
    fi
    echo "--- spec/abi.toml"
    if PY="$(find_python)"; then
        if "$PY" "$V2_ROOT/test/abi/check_abi.py" --file "$REPO_ROOT/spec/abi.toml"; then
            echo "--- abi spec: OK"
        else
            echo "--- abi spec: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- golden trace (D2-43)"
        if (cd "$REPO_ROOT" && "$PY" v2/test/trace/gen_golden.py --check); then
            echo "--- golden trace: OK"
        else
            echo "--- golden trace: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- kịch bản .scn (KT-04c)"
        if (cd "$REPO_ROOT" && "$PY" v2/test/scn/check_scn.py); then
            echo "--- scn: OK"
        else
            echo "--- scn: FAIL" >&2
            fails=$((fails + 1))
        fi
        if (cd "$REPO_ROOT" && PYTHON="$PY" bash v2/test/scn/run_fixtures.sh >/dev/null 2>&1); then
            echo "--- scn fixtures: OK (5 case âm, kiểm thông điệp)"
        else
            echo "--- scn fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- báo cáo R1-v2 (Khối E)"
        if (cd "$REPO_ROOT" && "$PY" v2/test/report/check_report.py --all); then
            echo "--- báo cáo: OK"
        else
            echo "--- báo cáo: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- fixture âm của máy kiểm báo cáo"
        if (cd "$REPO_ROOT" && PYTHON="$PY" bash v2/test/report/run_fixtures.sh); then
            echo "--- báo cáo fixtures: OK"
        else
            echo "--- báo cáo fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        # KT-04b: object reserved — nay nằm trong spec/abi.toml (D2-32)
        if "$PY" "$V2_ROOT/test/abi/check_reserved.py" --file "$REPO_ROOT/spec/abi.toml"; then
            echo "--- abi reserved: OK"
        echo "--- fixture âm của máy kiểm ABI"
        if (cd "$REPO_ROOT" && PYTHON="$PY" bash v2/test/abi/run_fixtures.sh); then
            echo "--- abi fixtures: OK"
        echo "--- gen-check (KT-05: code + docs sinh từ spec)"
        if (cd "$REPO_ROOT" && ./v2/bin/vifast-gen --check); then
            echo "--- gen-check: OK"
        else
            echo "--- gen-check: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- fixture âm của gen-check"
        if (cd "$REPO_ROOT" && bash v2/test/gen/run_fixtures.sh); then
            echo "--- gen fixtures: OK"
        else
            echo "--- gen fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        # KT-69: stub IDL sinh từ `v2/lib/vifast-idl/idl/*.vidl` — cùng luật gen-check (D2-11):
        # sửa tay stub hoặc sửa IDL mà không sinh lại đều bị bắt.
        echo "--- idl-gen-check (KT-69: stub sinh từ .vidl)"
        if (cd "$REPO_ROOT" && ./v2/bin/vifast-idl --check); then
            echo "--- idl-gen-check: OK"
        else
            echo "--- idl-gen-check: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- fixture âm của idl-gen-check"
        if (cd "$REPO_ROOT" && bash v2/test/gen/run_idl_fixtures.sh); then
            echo "--- idl fixtures: OK"
        else
            echo "--- idl fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        else
            echo "--- abi fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        else
            echo "--- abi reserved: FAIL" >&2
            fails=$((fails + 1))
        fi
    else
        echo "--- abi spec: FAIL (không có python ≥3.11 với tomllib)" >&2
        fails=$((fails + 1))
    fi
    run_step "build (L0 compile)" "$CARGO" build --manifest-path "$MANIFEST" --workspace || fails=$((fails + 1))
    if [ "$fails" -ne 0 ]; then
        echo "v2 check: $fails bước FAIL" >&2
        return 1
    fi
    echo "v2 check: PASS (L1 chạy trong gate --fast)"
}

do_gate_fast() {
    do_check || return 1
    run_step "L0 test" "$CARGO" test --manifest-path "$MANIFEST" --workspace || return 1
    # KT-148 (D2-128): workspace **kernel** có manifest riêng (`v2/kernel/Cargo.toml`) nên `L0 test`
    # của `v2/Cargo.toml` **không** chạy nó — thiếu bước này thì test `smp` (bố cục per-hart) đỏ
    # mà cổng vẫn xanh (đúng lỗi B7). `vifast-virtio` **không** thuộc workspace kernel (nó là
    # path-dep của `v2/lib`) nên đã nằm trong L0 của `v2/Cargo.toml` — **không** thêm lần hai.
    # **KT-166** (review L6, KT-161 §3.5): `vifast-plat-aarch64` là member của workspace kernel
    # nhưng **không** được test ở đâu trong cổng — 22 test host + việc crate **có biên dịch** chỉ
    # được kiểm khi ai đó gõ tay đúng lệnh. Thêm `-p` thứ hai để crate nằm trong L0 thật sự.
    # **KT-186 (D2-163)**: `vifast-plat-x86_64` là member mới của workspace kernel (K5' bước M2);
    # thêm vào L0 để test host của nó nằm trong cổng thật sự, không chỉ gõ tay.
    run_step "L0 kernel workspace (KT-148)" "$CARGO" test --manifest-path "$V2_ROOT/kernel/Cargo.toml" -p vifast-plat-common -p vifast-plat-aarch64 -p vifast-plat-x86_64 || return 1
    echo "--- L1 (sim 1.000 seed)"
    local t0 t1
    PYTHON="$(find_python || true)"
    t0=$("$PYTHON" -c 'import time;print(int(time.time()*1000))')
    if out=$("$CARGO" test --manifest-path "$MANIFEST" -p vifast-sim l1_ -- --nocapture 2>&1); then
        echo "$out" | grep -E "^# L1 OK" || true
        t1=$("$PYTHON" -c 'import time;print(int(time.time()*1000))')
        echo "--- L1: OK ($((t1 - t0)) ms, đo bởi cổng)"
    else
        echo "$out" >&2
        echo "--- L1: FAIL" >&2
        return 1
    fi
    # **KT-134 (Agent 0, phần 3)**: nhóm selftest **chậm** — chúng dựng log/ảnh giả hoặc gọi QEMU
    # nên không đặt trong `check`; đặt ở đây để vẫn có cổng gọi (không cổng nào gọi = mục được
    # phép mục âm thầm, đúng lỗi đã xảy ra với `build-rev.sh --selftest`).
    run_step "selftest runner ktest (KT-54)" bash "$V2_ROOT/test/boot/selftest.sh" || return 1
    run_step "selftest qemu guard (KT-78)" bash "$V2_ROOT/test/boot/guard_selftest.sh" || return 1
    run_step "selftest pre-measure (KT-95)" bash "$V2_ROOT/tools/pre-measure.sh" --selftest || return 1
    run_step "selftest pin-artifact (KT-84)" bash "$V2_ROOT/tools/pin-artifact.sh" --selftest || return 1
    # **KT-145 (Agent 0 phiếu lượt 5 §A4)**: đường đo phải TỪ CHỐI ảnh không cùng định nghĩa dấu
    # vân tay; chỉ `status.sh`/`pin-artifact.sh` được nhận dạng cũ. Ca này chạy **chính** ba script
    # đường đo trên ảnh giả (dạng cũ / algo sai / algo đúng) + quét toàn bộ `v2/` tìm chỗ còn nhận
    # dạng cũ. Không QEMU, không build ⇒ vài giây.
    run_step "algo= nghiêm ngặt ở đường đo (KT-145)" bash "$V2_ROOT/test/boot/algo-strict.sh" || return 1
    # **KT-134 (Agent 0, phần 3)**: `persist.sh --red-selftest` cần QEMU nên để ở đây, không ở
    # `check`. Khi `nightly` đầy đủ có thì chuyển sang đó (Agent 0: "khi nightly đầy đủ có thì
    # chuyển sang").
    run_step "selftest persist đỏ-trước (KT-75)" bash "$V2_ROOT/test/boot/persist.sh" --red-selftest || return 1
    # **KT-136 (Agent 0, lượt 4, việc 2)**: cắt điện giữa lúc kernel đang ghi pha 7 rồi kiểm ảnh
    # đĩa (fsck sạch + dữ liệu đã commit còn nguyên + tệp dở phải là tiền tố) và kiểm FS còn
    # đọc/ghi được sau đó. Đo bằng `date +%s%N`: ~17 s (build đã cache) ⇒ vừa `gate --fast`.
    # Soak 100 boot (`--soak 10`) thì **không** vào cổng: ~3 phút, để chạy riêng làm bằng chứng.
    run_step "cắt điện giữa lúc ghi (KT-136)" bash "$V2_ROOT/test/boot/persist.sh" --crash || return 1
    # **KT-139 (Agent 0)**: ba script tự kiểm **độc lập** (không cờ `--selftest`, nhận theo tên
    # tệp) trước đây **không cổng nào gọi** — cùng lớp lỗi đã làm `build-rev.sh --selftest` đỏ âm
    # thầm. Cả ba đều **chậm** (đo bằng `date +%s%N`: selfbreak ~95 s, neg-test ~12 s,
    # neg-test-kt85b ~26 s) nên đặt ở `gate --fast`, KHÔNG đặt ở `check` (check phải nhanh).
    # Vì sao `selfbreak.sh` quan trọng: nó là **đường duy nhất** chạm `verify-numbers.py --self-test`
    # (hai lời gọi trong ca luật 8) ⇒ nối nó là nối luôn chuỗi đó vào cổng.
    run_step "selfbreak 5 luật K6 (KT-80)" bash "$V2_ROOT/test/rules/selfbreak.sh" || return 1
    # Hai script git-guard cần **hook đã cài** (`v2/tools/git-guard/install.sh`; hook không đi theo
    # git). Thiếu hook thì chúng tự in "hook CHƯA cài đúng — chạy …install.sh trước" và exit 2 ⇒
    # cổng ĐỎ kèm lý do, không im lặng bỏ qua. Chúng tự dọn worktree/nhánh tạm và tự kiểm bất biến
    # (HEAD/index/số worktree của checkout chính không đổi) nên chạy được trong cổng.
    run_step "ca âm git-guard (KT-85)" bash "$V2_ROOT/tools/git-guard/neg-test.sh" || return 1
    # **R5 (Agent 0, lượt 4)**: tên nhánh tạm của `neg-test.sh` từng là hằng số `task/kt85neg` ⇒
    # hai lần chạy song song tranh nhau cùng một nhánh (lần hai `worktree add -b` hỏng, trap lần
    # nhất xoá nhánh lần hai). Ca này chạy **đúng hai lần song song** và đòi cả hai PASS; nó đỏ
    # nếu ai đưa tên nhánh về hằng số. Đo bằng `date +%s%N`: ~14 s.
    run_step "ca âm git-guard song song (R5)" bash "$V2_ROOT/tools/git-guard/neg-test.sh" --selftest-parallel || return 1
    run_step "ca âm git-guard b (KT-85b)" bash "$V2_ROOT/tools/git-guard/neg-test-kt85b.sh" || return 1
    echo "v2 gate --fast: PASS (gen-check ON từ KT-05; L1 sim 1.000 seed)"
}

# ---------------------------------------------------------------- Miri (KT-13/KT-17, D2-47)

# In đúng câu lệnh bootstrap khi thiếu toolchain — không bao giờ im lặng bỏ qua.
miri_bootstrap_hint() {
    echo "v2 miri: bootstrap Miri bằng:" >&2
    echo "    rustup toolchain install nightly" >&2
    echo "    rustup component add miri rust-src --toolchain nightly" >&2
}

# Kiểm toolchain Miri đủ (nightly + miri + rust-src + `cargo miri` chạy được).
# Thiếu ⇒ in câu lệnh bootstrap và exit (127 nếu thiếu rustup, 2 nếu thiếu component).
# Dùng chung cho `v2 miri` (KT-13) và `v2 nightly --only-miri` (KT-17) để hai lệnh không
# bao giờ lệch nhau về điều kiện "đủ toolchain" (fail rõ, không im lặng).
require_miri_toolchain() {
    local ten="${1:-v2 miri}" rustup_bin installed missing
    rustup_bin="$(find_rustup)" || {
        echo "$ten: không tìm thấy rustup (đã thử PATH, ~/.cargo/bin, /usr/local/cargo/bin, /opt/homebrew/bin)" >&2
        miri_bootstrap_hint
        exit 127
    }
    if ! "$rustup_bin" toolchain list 2>/dev/null | grep -q '^nightly'; then
        echo "$ten: thiếu toolchain nightly của rustup" >&2
        miri_bootstrap_hint
        exit 2
    fi
    installed="$("$rustup_bin" component list --installed --toolchain nightly 2>/dev/null || true)"
    missing=""
    printf '%s\n' "$installed" | grep -qE '^miri(-|$)' || missing="miri"
    printf '%s\n' "$installed" | grep -qE '^rust-src$' || missing="${missing:+$missing }rust-src"
    if [ -n "$missing" ]; then
        echo "$ten: toolchain nightly thiếu component: $missing" >&2
        miri_bootstrap_hint
        exit 2
    fi
    # `component list` có thể lệch với thực tế — xác nhận cargo-miri chạy được.
    if ! "$CARGO" +nightly miri --version >/dev/null 2>&1; then
        echo "$ten: 'cargo +nightly miri --version' thất bại dù component đã cài" >&2
        miri_bootstrap_hint
        exit 2
    fi
}

do_miri() {
    local sub
    require_miri_toolchain "v2 miri"
    # Mặc định `test` (DoD KT-13: `v2 miri -p vifast-sim --lib`); chuyển tiếp nguyên tham số.
    sub="test"
    case "${1:-}" in
        run | r | test | t | nextest | setup | clean)
            sub="$1"
            shift
            ;;
    esac
    case "$sub" in
        setup | clean) exec "$CARGO" +nightly miri "$sub" "$@" ;;
        *) exec "$CARGO" +nightly miri "$sub" --manifest-path "$MANIFEST" "$@" ;;
    esac
}

# Một bước Miri của tập chọn; dừng ngay ở bước đỏ (không retry — D2-07).
run_miri_test() {
    local ten="$1"
    shift
    echo "--- Miri $ten"
    if "$CARGO" +nightly miri test --manifest-path "$MANIFEST" "$@"; then
        echo "--- Miri $ten: OK"
        return 0
    fi
    echo "--- Miri $ten: FAIL" >&2
    return 1
}

# KT-17 (D2-47(a)): CHỈ Miri trên tập chọn; KHÔNG L1 100k/mutation/soak.
#
# Tập chọn: toàn bộ `vifast-objmem` (lib + alias + fuzz 200 chuỗi + contract) và các test
# sim đi qua object store: `--lib`, kt16_objmem, kt09_untyped, kt09_revoke (plan §4 KT-17),
# kt10_cnode, kt17_align. Không chạy `l1` (tránh L1 1.000 seed dưới Miri).
# **KT-23** (K1B-PLAN §5 KT-23 DoD 4): thêm các test K1b đi qua TCB/scheduler/budget/donation/
# hộp thư — kt18_tcb, kt19_sched, kt20_budget, kt21_donation, kt22_mailbox (mỗi tệp tự giảm
# seed/bước bằng `cfg(miri)`); **không** thêm `kt23_k1b` (1.000 seed × 64 bước — keo dài, và
# không có I/O cần Miri kiểm; bất biến của nó chạy trong L0). KHÔNG thêm test I/O.
# **KT-24** (K1C-PLAN §5 KT-24 DoD 9): thêm `kt24_ipc` (MessageInfo/64 MR/ipc::transfer/no_reply;
# fuzz tự giảm seed/bước bằng `cfg(miri)`). KHÔNG thêm `kt24_scn` (đọc tệp — test I/O).
# **KT-26** (K1C-PLAN §5 KT-26 DoD 8): thêm `kt26_fault` (FaultKind 4 biến thể model-only, fault
# Call+Reply, `tcb_resume_with_regs`, Exit D2-25, mô hình procsrv; fuzz 1.000 seed tự giảm còn
# 3 seed × 8 op bằng `cfg(miri)`). KHÔNG thêm `kt26_scn` (đọc tệp — test I/O).
# **KT-27** (K1C-PLAN §5 KT-27 DoD 8): thêm `kt27_notification` (word 64 + badge, Signal OR, một
# waiter, Wait/Poll, bind 1:1, TCB chết; fuzz 1.000 seed tự giảm còn 3 seed × 8 op bằng
# `cfg(miri)`). KHÔNG thêm `kt27_scn` (đọc tệp — test I/O).
# **KT-28** (K1C-PLAN §5 KT-28 DoD 8): thêm `kt28_waitaddr` (bảng băm `(frame, offset)` 64 bucket,
# WaitAddr đọc giá trị + xếp hàng một lần, `WakeAddr(n)`, không timeout; fuzz 1.000 seed tự giảm
# còn 3 seed × 8 op bằng `cfg(miri)`). KHÔNG có tệp `.scn` mới nên không có test I/O để bỏ.
# **KT-29** (K1C-PLAN §5 KT-29 DoD 8) — L1 theo `smp`: driver `tests/l1_k1c.rs` đọc
# `VIFAST_SMP`/`VIFAST_SEEDS`; mặc định 10.000 seed × smp 1,2,4,8. `gate --fast` KHÔNG gọi
# lệnh này (vẫn 1.000 seed/smp 1 qua env mặc định của test `l1_k1c`). 100.000 seed là cổng
# cuối phase §7.1, chạy bằng `--seeds 100000` khi tới cổng — không nhét vào `--fast`.
do_nightly_l1() {
    local seeds="10000" smp="1,2,4,8"
    while [ $# -gt 0 ]; do
        case "$1" in
            --seeds)
                [ $# -ge 2 ] || { echo "v2 nightly --l1: --seeds cần giá trị" >&2; return 2; }
                seeds="$2"
                shift 2
                ;;
            --smp)
                [ $# -ge 2 ] || { echo "v2 nightly --l1: --smp cần giá trị" >&2; return 2; }
                smp="$2"
                shift 2
                ;;
            *)
                echo "v2 nightly --l1: tham số lạ '$1' (nhận: --seeds N, --smp a,b,c)" >&2
                return 2
                ;;
        esac
    done
    case "$seeds" in
        ''|*[!0-9]*) echo "v2 nightly --l1: --seeds phải là số dương (nhận '$seeds')" >&2; return 2 ;;
    esac
    [ "$seeds" -gt 0 ] || { echo "v2 nightly --l1: --seeds phải dương" >&2; return 2; }
    echo "== v2 nightly --l1 (KT-29): seeds=$seeds smp=$smp; driver tests/l1_k1c.rs =="
    local t0 t1
    t0="$(date +%s)"
    if ! VIFAST_SEEDS="$seeds" VIFAST_SMP="$smp" "$CARGO" test --manifest-path "$MANIFEST" \
        -p vifast-sim driver_smp -- --nocapture; then
        echo "v2 nightly --l1: FAIL" >&2
        return 1
    fi
    t1="$(date +%s)"
    echo "v2 nightly --l1: PASS ($((t1 - t0)) s; seeds=$seeds smp=$smp)"
}

do_nightly_only_miri() {
    local t0 t1
    require_miri_toolchain "v2 nightly --only-miri"
    echo "== v2 nightly --only-miri (D2-47(a)): Miri trên tập chọn; KHÔNG L1 100k/mutation/soak =="
    t0="$(date +%s)"
    run_miri_test "vifast-objmem (lib + alias + fuzz 200 + contract)" -p vifast-objmem || return 1
    run_miri_test "vifast-sim --lib" -p vifast-sim --lib || return 1
    run_miri_test "vifast-sim kt16_objmem" -p vifast-sim --test kt16_objmem || return 1
    run_miri_test "vifast-sim kt09_untyped" -p vifast-sim --test kt09_untyped || return 1
    run_miri_test "vifast-sim kt09_revoke" -p vifast-sim --test kt09_revoke || return 1
    run_miri_test "vifast-sim kt10_cnode" -p vifast-sim --test kt10_cnode || return 1
    run_miri_test "vifast-sim kt17_align" -p vifast-sim --test kt17_align || return 1
    run_miri_test "vifast-sim kt18_tcb" -p vifast-sim --test kt18_tcb || return 1
    run_miri_test "vifast-sim kt19_sched" -p vifast-sim --test kt19_sched || return 1
    run_miri_test "vifast-sim kt20_budget" -p vifast-sim --test kt20_budget || return 1
    run_miri_test "vifast-sim kt21_donation" -p vifast-sim --test kt21_donation || return 1
    run_miri_test "vifast-sim kt22_mailbox" -p vifast-sim --test kt22_mailbox || return 1
    run_miri_test "vifast-sim kt24_ipc" -p vifast-sim --test kt24_ipc || return 1
    # **KT-33** (D2-61/K1C-DOD §4): thêm `kt25_ipc2` — KT-31 đã ghi nợ "Miri all thiếu kt25_ipc2";
    # tệp tự giảm fuzz còn 3 seed × 8 op bằng `cfg(miri)` như các tệp K1c khác. KHÔNG thêm
    # `kt25_scn` (đọc tệp — test I/O) và không chạy `l1_k1c`.
    run_miri_test "vifast-sim kt25_ipc2" -p vifast-sim --test kt25_ipc2 || return 1
    run_miri_test "vifast-sim kt26_fault" -p vifast-sim --test kt26_fault || return 1
    run_miri_test "vifast-sim kt27_notification" -p vifast-sim --test kt27_notification || return 1
    run_miri_test "vifast-sim kt28_waitaddr" -p vifast-sim --test kt28_waitaddr || return 1
    # **KT-29** (K1C-PLAN §5 KT-29 DoD 9): thêm `kt29_smp` (SMP 1/2/4/8 + push migration; fuzz
    # tự giảm còn 3 seed × 8 op bằng `cfg(miri)`, stable vẫn 1.000 × 64 × 4). KHÔNG thêm
    # `l1_k1c` (1.000 seed — chạy ở gate/nightly --l1, không dưới Miri).
    run_miri_test "vifast-sim kt29_smp" -p vifast-sim --test kt29_smp || return 1
    # **KT-43** (K2-PLAN §4.2 D8 — Miri **toàn bộ** tập ảnh hưởng K2): thêm 4 tệp còn thiếu của
    # K2 (`kt36_frame`, `kt37_pagetable`, `kt38_vspace`, `kt39_wx`) + crate `vifast-pte` (KT-35).
    # Các tệp tự giảm seed/property bằng `cfg(miri)` như KT-36..42 (D2-47(a)); **không** thêm
    # `kt42_scn`/`kt43_scn` (đọc tệp) và **không** chạy `l1_k1c` 1.000 seed dưới Miri (lần chạy
    # mẫu KT-43 có env riêng, log `JOURNAL/kt43-miri-l1.log`).
    run_miri_test "vifast-sim kt36_frame" -p vifast-sim --test kt36_frame || return 1
    run_miri_test "vifast-sim kt37_pagetable" -p vifast-sim --test kt37_pagetable || return 1
    run_miri_test "vifast-sim kt38_vspace" -p vifast-sim --test kt38_vspace || return 1
    run_miri_test "vifast-sim kt39_wx" -p vifast-sim --test kt39_wx || return 1
    run_miri_test "vifast-pte (unit + doctest)" -p vifast-pte || return 1
    # **KT-40** (K2-PLAN §3 KT-40): thêm `kt40_tlb` (TLB 16 entry/hart + shootdown/ack + deadlock;
    # property tự giảm còn 2 hart × 150 vòng và ca cạn 256 ASID tự bỏ bằng `cfg(miri)`).
    run_miri_test "vifast-sim kt40_tlb" -p vifast-sim --test kt40_tlb || return 1
    # **KT-41** (K2-PLAN §3 KT-41; D2-65 Q6): thêm `kt41_vmfault` (FaultKind::Vm model-only, 3
    # reason NotMapped/Permission/Wx, fault_ep/K1c, resume, C2; property tự giảm còn 150 vòng
    # bằng `cfg(miri)`).
    run_miri_test "vifast-sim kt41_vmfault" -p vifast-sim --test kt41_vmfault || return 1
    # **KT-42** (K2-PLAN §3 KT-42): thêm `kt42_vmcheck` — một cửa `check_vm` ở cổng trên trạng
    # thái VM đầy đủ (Frame 3 cỡ, 2 VSpace shared read-only, TLB, shootdown). KHÔNG thêm
    # `kt42_scn` (đọc tệp — test I/O); unit test `check_vm` nằm trong `--lib` đã có ở trên.
    run_miri_test "vifast-sim kt42_vmcheck" -p vifast-sim --test kt42_vmcheck || return 1
    # **KT-30** (K1C-PLAN §5 KT-30 DoD 8): thêm `-p vifast-sync` (MCS lock + Mailbox MPSC; test
    # `kt30_stress` 4 luồng tự gạt bằng `#![cfg(not(miri))]` nên Miri chỉ chạy phần single-thread).
    run_miri_test "vifast-sync (lib + kt30_sync)" -p vifast-sync || return 1
    t1="$(date +%s)"
    echo "v2 nightly --only-miri: PASS ($((t1 - t0)) s; không mutation/soak/L1 100k)"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    sim)
        exec "$CARGO" run -q --manifest-path "$V2_ROOT/Cargo.toml" -p vifast-sim -- "$@"
        ;;
    agentctl)
        exec "$CARGO" run -q --manifest-path "$V2_ROOT/Cargo.toml" -p vifast-agentctl -- "$@"
        ;;
    check) do_check ;;
    gate)
        if [ "${1:-}" = "--fast" ]; then
            do_gate_fast
        else
            echo "v2: cổng đầy đủ CHƯA CÓ trong vòng 1 — chỉ dùng 'gate --fast' (AGENTS.md §6)" >&2
            exit 2
        fi
        ;;
    nightly)
        if [ "${1:-}" = "--only-miri" ]; then
            if [ $# -ne 1 ]; then
                echo "v2: 'nightly --only-miri' không nhận thêm tham số (nhận: $*)" >&2
                exit 2
            fi
            do_nightly_only_miri
        elif [ "${1:-}" = "--l1" ]; then
            shift
            do_nightly_l1 "$@"
        else
            echo "v2: nightly đầy đủ CHƯA CÓ (cần L1 100k/mutation/soak); chỉ có 'v2 nightly --only-miri' — Miri trên tập chọn (KT-17, D2-47(a)); Miri rời: 'v2 miri'" >&2
            exit 2
        fi
        ;;
    miri) do_miri "$@" ;;
    status) exec bash "$V2_ROOT/tools/status.sh" "$@" ;;
    check-repro) exec bash "$V2_ROOT/tools/repro-check.sh" "$@" ;;
    check-rules) check_k6_rules "$@" ;;
    rules)
        root="$V2_ROOT"
        if [ "${1:-}" = "--root" ] && [ -n "${2:-}" ]; then
            root="$2"
        elif [ -n "${1:-}" ]; then
            echo "v2: 'rules' chỉ nhận --root <thư mục>" >&2
            exit 2
        fi
        if [ ! -d "$root" ]; then
            echo "v2: không có thư mục $root" >&2
            exit 2
        fi
        if rules "$root"; then
            echo "rules: PASS ($root)"
            exit 0
        fi
        echo "rules: FAIL ($root)" >&2
        exit 1
        ;;
    "" | -h | --help | help) usage ;;
    *)
        echo "v2: lệnh không biết: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac

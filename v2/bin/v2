#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# v2/bin/v2 — cổng của dòng OS v2 (KT-03).
#
# Vòng 1: fmt, clippy -D warnings, 5 luật cấu trúc (R1..R5), ABI/scn/report checks, L0, L1 1.000 seed.
# gen-check đã bật (KT-05); Miri có lệnh rời `v2 miri` (KT-13) và `nightly --only-miri` (KT-17, D2-47(a));
# nightly đầy đủ (L1 100k/mutation/soak) vẫn CHƯA CÓ — AGENTS.md §6.
# Mọi lệnh cargo dùng `--manifest-path v2/Cargo.toml`: KHÔNG bao giờ chạm workspace v1
# (crates/, 25 crate đã đóng băng ở tag v1-archive).
set -u

V2_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$V2_ROOT/.." && pwd)"
MANIFEST="$V2_ROOT/Cargo.toml"

# cargo có thể không nằm trên PATH (máy này: ~/.cargo/bin).
find_cargo() {
    if command -v cargo >/dev/null 2>&1; then
        command -v cargo
        return 0
    fi
    local c
    for c in "$HOME/.cargo/bin/cargo" "/usr/local/cargo/bin/cargo" "/opt/homebrew/bin/cargo"; do
        if [ -x "$c" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

CARGO="$(find_cargo)" || {
    echo "v2: không tìm thấy cargo (đã thử PATH, ~/.cargo/bin, /usr/local/cargo/bin, /opt/homebrew/bin)" >&2
    exit 127
}
export PATH="$(dirname "$CARGO"):$PATH"

# rustup có thể không nằm trên PATH (máy này: ~/.cargo/bin) — cùng cách tìm như cargo.
find_rustup() {
    if command -v rustup >/dev/null 2>&1; then
        command -v rustup
        return 0
    fi
    local c
    for c in "$HOME/.cargo/bin/rustup" "/usr/local/cargo/bin/rustup" "/opt/homebrew/bin/rustup"; do
        if [ -x "$c" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

find_python() {
    local c
    for c in python3.12 python3.11 python3; do
        if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import tomllib' >/dev/null 2>&1; then
            command -v "$c"
            return 0
        fi
    done
    return 1
}

usage() {
    cat <<'EOF'
v2 — cổng dòng OS ViFastOs v2 (vòng 1)

  ./v2/bin/v2 check            fmt + clippy + 5 luật cấu trúc + self-test luật + build
  ./v2/bin/v2 gate --fast      như check + L0 (cargo test --workspace). BẮT BUỘC cuối mỗi task
  ./v2/bin/v2 gate             CHƯA CÓ trong vòng 1 (cần L2/L3)
  ./v2/bin/v2 nightly --only-miri
                               CHỈ Miri trên tập chọn (KT-17, D2-47(a)): vifast-objmem (toàn bộ) +
                               sim (--lib, kt16_objmem, kt09_untyped, kt09_revoke, kt10_cnode,
                               kt17_align). KHÔNG L1 100k/mutation/soak
  ./v2/bin/v2 nightly          CHƯA CÓ cho nightly đầy đủ (L1 100k/mutation/soak) — chỉ có `--only-miri`
  ./v2/bin/v2 miri [test|run|setup|clean] [tuỳ chọn]
                               Miri qua `cargo +nightly miri` trên v2/Cargo.toml; mặc định `test`
                               (D2-47: lệnh rời, KHÔNG nằm trong gate --fast)
  ./v2/bin/v2 rules [--root D] chỉ chạy 5 luật cấu trúc trên D (mặc định v2/)

Luật: R1 tệp kernel/lib ≤1.500 dòng; R2 cấm cfg(target_arch) trong kernel/vifast-core + lib;
      R3 SPDX theo loại tệp; R4 cấm path-dependency sang crates/ (D2-26);
      R5 unsafe chỉ trong danh sách đóng (D2-17).
L1 đã bật từ KT-08: 1.000 seed trong `gate --fast`; nightly 100.000 seed + mutation/soak vẫn chưa có
(`nightly --only-miri` chỉ chạy Miri — D2-47(a)).
Bootstrap Miri (khi `v2 miri` báo thiếu toolchain): rustup component add miri rust-src --toolchain nightly
EOF
}

# ---------------------------------------------------------------- luật cấu trúc

# Tập thư mục được quét (thiết kế §8). Fixture của self-test nằm ở v2/test/rules nên
# không tự quét chính nó; `target/` luôn bị bỏ.
SCAN_DIRS="kernel lib sim user std boot test tools"

# rules <root>: in vi phạm "R<k> <đường dẫn>[:dòng]: <lý do>", trả 0 nếu sạch.
relpath() {
    case "$1" in
        "$REPO_ROOT"/*) printf '%s' "${1#"$REPO_ROOT"/}" ;;
        *) printf '%s' "${1#"$2"/}" ;;
    esac
}

rules() {
    local root found=0 dirs=() d f n line path
    root="$(cd "$1" 2>/dev/null && pwd)" || {
        echo "rules: không có thư mục $1" >&2
        return 1
    }
    # Fixture cố ý vi phạm nằm ở v2/test/fixtures — chỉ loại khi quét chính cây v2.
    local EXCL=(-not -path '/__khong_ton_tai__/*')
    if [ "$root" = "$V2_ROOT" ]; then
        EXCL=(-not -path "$V2_ROOT/test/fixtures/*")
    fi
    for d in $SCAN_DIRS; do
        [ -d "$root/$d" ] && dirs+=("$root/$d")
    done
    if [ "$root" = "$V2_ROOT" ] && [ -d "$REPO_ROOT/spec" ]; then
        dirs+=("$REPO_ROOT/spec")
    fi
    if [ "${#dirs[@]}" -eq 0 ]; then
        echo "rules: không có thư mục nào trong ($SCAN_DIRS) dưới $root" >&2
        return 1
    fi

    # R1: tệp trong kernel/ và lib/ không quá 1.500 dòng [TK]
    for d in kernel lib; do
        [ -d "$root/$d" ] || continue
        while IFS= read -r -d '' f; do
            n=$(wc -l <"$f" | tr -d ' ')
            if [ "$n" -gt 1500 ]; then
                echo "R1 $(relpath "$f" "$root"): $n dòng > 1500"
                found=1
            fi
        done < <(find "$root/$d" -type f \( -name '*.rs' -o -name '*.s' -o -name '*.asm' \) \
            -not -path '*/target/*' "${EXCL[@]}" -print0 2>/dev/null)
    done

    # R2: cấm cfg(target_arch) trong kernel/vifast-core và lib/ (thiết kế §8)
    for d in "$root/kernel/vifast-core" "$root/lib"; do
        [ -d "$d" ] || continue
        while IFS= read -r line; do
            echo "R2 ${line#"$root"/}"
            found=1
        done < <(grep -rn --include='*.rs' 'cfg(target_arch' "$d" 2>/dev/null)
    done

    # R3: SPDX theo loại tệp (QD §9.3)
    for d in "${dirs[@]}"; do
        while IFS= read -r -d '' f; do
            case "$f" in
                *.rs | *.s | *.asm | *.ld | *.toml | *.vis | *.vish | *.vidl | *.sh | *.py)
                    if ! head -5 "$f" | grep -q 'SPDX-License-Identifier'; then
                        echo "R3 $(relpath "$f" "$root"): thiếu SPDX-License-Identifier trong 5 dòng đầu"
                        found=1
                    fi
                    ;;
                *.json | *.bin | *.txt)
                    if [ ! -f "$f.license" ]; then
                        echo "R3 $(relpath "$f" "$root"): tệp không có cú pháp chú thích cần sidecar .license"
                        found=1
                    fi
                    ;;
            esac
        done < <(find "$d" -type f -not -path '*/target/*' "${EXCL[@]}" -print0 2>/dev/null)
    done

    # R4: cấm path-dependency sang crates/ — v1 đã đóng băng (D2-26)
    for d in "${dirs[@]}"; do
        while IFS= read -r -d '' f; do
            n=0
            while IFS= read -r line; do
                n=$((n + 1))
                echo "R4 $(relpath "$f" "$root"):$n: path-dependency sang crates/ ($line)"
                found=1
            done < <(grep -nE 'path[[:space:]]*=[[:space:]]*"[^"]*crates/' "$f" 2>/dev/null)
        done < <(find "$d" -name Cargo.toml -not -path '*/target/*' "${EXCL[@]}" -print0 2>/dev/null)
    done

    # R5: unsafe chỉ trong danh sách đóng (D2-17): vifast-sync, vifast-objmem,
    #     kernel/vifast-plat-*, boot/
    for d in "${dirs[@]}"; do
        while IFS= read -r -d '' f; do
            path="$(relpath "$f" "$root")"
            case "$f" in
                "$root"/boot/* | "$root"/kernel/vifast-plat-* | *vifast-sync* | *vifast-objmem*) continue ;;
            esac
            while IFS= read -r line; do
                echo "R5 $line"
                found=1
            done < <(grep -nE '\bunsafe[[:space:]]*(fn|impl|trait|extern|\{)' "$f" 2>/dev/null |
                sed "s|^|$path:|")
        done < <(find "$d" -name '*.rs' -not -path '*/target/*' "${EXCL[@]}" -print0 2>/dev/null)
    done

    return "$found"
}

# ---------------------------------------------------------------- các lệnh

run_step() { # <tên> <lệnh...>
    local name="$1"
    shift
    echo "--- $name"
    if "$@"; then
        echo "--- $name: OK"
        return 0
    fi
    echo "--- $name: FAIL" >&2
    return 1
}

do_check() {
    local fails=0
    echo "== v2 check (HEAD $(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')) =="
    run_step "fmt" "$CARGO" fmt --all --check --manifest-path "$MANIFEST" || fails=$((fails + 1))
    run_step "clippy" "$CARGO" clippy --manifest-path "$MANIFEST" --workspace --all-targets -- -D warnings || fails=$((fails + 1))
    echo "--- luật cấu trúc R1..R5"
    if rules "$V2_ROOT"; then echo "--- luật cấu trúc: OK"; else echo "--- luật cấu trúc: FAIL" >&2; fails=$((fails + 1)); fi
    run_step "self-test luật" bash "$V2_ROOT/test/rules/run.sh" || fails=$((fails + 1))
    echo "--- spec/abi.toml"
    if PY="$(find_python)"; then
        if "$PY" "$V2_ROOT/test/abi/check_abi.py" --file "$REPO_ROOT/spec/abi.toml"; then
            echo "--- abi spec: OK"
        else
            echo "--- abi spec: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- golden trace (D2-43)"
        if (cd "$REPO_ROOT" && "$PY" v2/test/trace/gen_golden.py --check); then
            echo "--- golden trace: OK"
        else
            echo "--- golden trace: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- kịch bản .scn (KT-04c)"
        if (cd "$REPO_ROOT" && "$PY" v2/test/scn/check_scn.py); then
            echo "--- scn: OK"
        else
            echo "--- scn: FAIL" >&2
            fails=$((fails + 1))
        fi
        if (cd "$REPO_ROOT" && PYTHON="$PY" bash v2/test/scn/run_fixtures.sh >/dev/null 2>&1); then
            echo "--- scn fixtures: OK (5 case âm, kiểm thông điệp)"
        else
            echo "--- scn fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- báo cáo R1-v2 (Khối E)"
        if (cd "$REPO_ROOT" && "$PY" v2/test/report/check_report.py --all); then
            echo "--- báo cáo: OK"
        else
            echo "--- báo cáo: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- fixture âm của máy kiểm báo cáo"
        if (cd "$REPO_ROOT" && PYTHON="$PY" bash v2/test/report/run_fixtures.sh); then
            echo "--- báo cáo fixtures: OK"
        else
            echo "--- báo cáo fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        # KT-04b: object reserved — nay nằm trong spec/abi.toml (D2-32)
        if "$PY" "$V2_ROOT/test/abi/check_reserved.py" --file "$REPO_ROOT/spec/abi.toml"; then
            echo "--- abi reserved: OK"
        echo "--- fixture âm của máy kiểm ABI"
        if (cd "$REPO_ROOT" && PYTHON="$PY" bash v2/test/abi/run_fixtures.sh); then
            echo "--- abi fixtures: OK"
        echo "--- gen-check (KT-05: code + docs sinh từ spec)"
        if (cd "$REPO_ROOT" && ./v2/bin/vifast-gen --check); then
            echo "--- gen-check: OK"
        else
            echo "--- gen-check: FAIL" >&2
            fails=$((fails + 1))
        fi
        echo "--- fixture âm của gen-check"
        if (cd "$REPO_ROOT" && bash v2/test/gen/run_fixtures.sh); then
            echo "--- gen fixtures: OK"
        else
            echo "--- gen fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        else
            echo "--- abi fixtures: FAIL" >&2
            fails=$((fails + 1))
        fi
        else
            echo "--- abi reserved: FAIL" >&2
            fails=$((fails + 1))
        fi
    else
        echo "--- abi spec: FAIL (không có python ≥3.11 với tomllib)" >&2
        fails=$((fails + 1))
    fi
    run_step "build (L0 compile)" "$CARGO" build --manifest-path "$MANIFEST" --workspace || fails=$((fails + 1))
    if [ "$fails" -ne 0 ]; then
        echo "v2 check: $fails bước FAIL" >&2
        return 1
    fi
    echo "v2 check: PASS (L1 chạy trong gate --fast)"
}

do_gate_fast() {
    do_check || return 1
    run_step "L0 test" "$CARGO" test --manifest-path "$MANIFEST" --workspace || return 1
    echo "--- L1 (sim 1.000 seed)"
    local t0 t1
    PYTHON="$(find_python || true)"
    t0=$("$PYTHON" -c 'import time;print(int(time.time()*1000))')
    if out=$("$CARGO" test --manifest-path "$MANIFEST" -p vifast-sim l1_ -- --nocapture 2>&1); then
        echo "$out" | grep -E "^# L1 OK" || true
        t1=$("$PYTHON" -c 'import time;print(int(time.time()*1000))')
        echo "--- L1: OK ($((t1 - t0)) ms, đo bởi cổng)"
    else
        echo "$out" >&2
        echo "--- L1: FAIL" >&2
        return 1
    fi
    echo "v2 gate --fast: PASS (gen-check ON từ KT-05; L1 sim 1.000 seed)"
}

# ---------------------------------------------------------------- Miri (KT-13/KT-17, D2-47)

# In đúng câu lệnh bootstrap khi thiếu toolchain — không bao giờ im lặng bỏ qua.
miri_bootstrap_hint() {
    echo "v2 miri: bootstrap Miri bằng:" >&2
    echo "    rustup toolchain install nightly" >&2
    echo "    rustup component add miri rust-src --toolchain nightly" >&2
}

# Kiểm toolchain Miri đủ (nightly + miri + rust-src + `cargo miri` chạy được).
# Thiếu ⇒ in câu lệnh bootstrap và exit (127 nếu thiếu rustup, 2 nếu thiếu component).
# Dùng chung cho `v2 miri` (KT-13) và `v2 nightly --only-miri` (KT-17) để hai lệnh không
# bao giờ lệch nhau về điều kiện "đủ toolchain" (fail rõ, không im lặng).
require_miri_toolchain() {
    local ten="${1:-v2 miri}" rustup_bin installed missing
    rustup_bin="$(find_rustup)" || {
        echo "$ten: không tìm thấy rustup (đã thử PATH, ~/.cargo/bin, /usr/local/cargo/bin, /opt/homebrew/bin)" >&2
        miri_bootstrap_hint
        exit 127
    }
    if ! "$rustup_bin" toolchain list 2>/dev/null | grep -q '^nightly'; then
        echo "$ten: thiếu toolchain nightly của rustup" >&2
        miri_bootstrap_hint
        exit 2
    fi
    installed="$("$rustup_bin" component list --installed --toolchain nightly 2>/dev/null || true)"
    missing=""
    printf '%s\n' "$installed" | grep -qE '^miri(-|$)' || missing="miri"
    printf '%s\n' "$installed" | grep -qE '^rust-src$' || missing="${missing:+$missing }rust-src"
    if [ -n "$missing" ]; then
        echo "$ten: toolchain nightly thiếu component: $missing" >&2
        miri_bootstrap_hint
        exit 2
    fi
    # `component list` có thể lệch với thực tế — xác nhận cargo-miri chạy được.
    if ! "$CARGO" +nightly miri --version >/dev/null 2>&1; then
        echo "$ten: 'cargo +nightly miri --version' thất bại dù component đã cài" >&2
        miri_bootstrap_hint
        exit 2
    fi
}

do_miri() {
    local sub
    require_miri_toolchain "v2 miri"
    # Mặc định `test` (DoD KT-13: `v2 miri -p vifast-sim --lib`); chuyển tiếp nguyên tham số.
    sub="test"
    case "${1:-}" in
        run | r | test | t | nextest | setup | clean)
            sub="$1"
            shift
            ;;
    esac
    case "$sub" in
        setup | clean) exec "$CARGO" +nightly miri "$sub" "$@" ;;
        *) exec "$CARGO" +nightly miri "$sub" --manifest-path "$MANIFEST" "$@" ;;
    esac
}

# Một bước Miri của tập chọn; dừng ngay ở bước đỏ (không retry — D2-07).
run_miri_test() {
    local ten="$1"
    shift
    echo "--- Miri $ten"
    if "$CARGO" +nightly miri test --manifest-path "$MANIFEST" "$@"; then
        echo "--- Miri $ten: OK"
        return 0
    fi
    echo "--- Miri $ten: FAIL" >&2
    return 1
}

# KT-17 (D2-47(a)): CHỈ Miri trên tập chọn; KHÔNG L1 100k/mutation/soak.
#
# Tập chọn: toàn bộ `vifast-objmem` (lib + alias + fuzz 200 chuỗi + contract) và các test
# sim đi qua object store: `--lib`, kt16_objmem, kt09_untyped, kt09_revoke (plan §4 KT-17),
# kt10_cnode, kt17_align. Không chạy `l1` (tránh L1 1.000 seed dưới Miri).
do_nightly_only_miri() {
    local t0 t1
    require_miri_toolchain "v2 nightly --only-miri"
    echo "== v2 nightly --only-miri (D2-47(a)): Miri trên tập chọn; KHÔNG L1 100k/mutation/soak =="
    t0="$(date +%s)"
    run_miri_test "vifast-objmem (lib + alias + fuzz 200 + contract)" -p vifast-objmem || return 1
    run_miri_test "vifast-sim --lib" -p vifast-sim --lib || return 1
    run_miri_test "vifast-sim kt16_objmem" -p vifast-sim --test kt16_objmem || return 1
    run_miri_test "vifast-sim kt09_untyped" -p vifast-sim --test kt09_untyped || return 1
    run_miri_test "vifast-sim kt09_revoke" -p vifast-sim --test kt09_revoke || return 1
    run_miri_test "vifast-sim kt10_cnode" -p vifast-sim --test kt10_cnode || return 1
    run_miri_test "vifast-sim kt17_align" -p vifast-sim --test kt17_align || return 1
    t1="$(date +%s)"
    echo "v2 nightly --only-miri: PASS ($((t1 - t0)) s; không mutation/soak/L1 100k)"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    sim)
        exec "$CARGO" run -q --manifest-path "$V2_ROOT/Cargo.toml" -p vifast-sim -- "$@"
        ;;
    agentctl)
        exec "$CARGO" run -q --manifest-path "$V2_ROOT/Cargo.toml" -p vifast-agentctl -- "$@"
        ;;
    check) do_check ;;
    gate)
        if [ "${1:-}" = "--fast" ]; then
            do_gate_fast
        else
            echo "v2: cổng đầy đủ CHƯA CÓ trong vòng 1 — chỉ dùng 'gate --fast' (AGENTS.md §6)" >&2
            exit 2
        fi
        ;;
    nightly)
        if [ "${1:-}" = "--only-miri" ]; then
            if [ $# -ne 1 ]; then
                echo "v2: 'nightly --only-miri' không nhận thêm tham số (nhận: $*)" >&2
                exit 2
            fi
            do_nightly_only_miri
        else
            echo "v2: nightly đầy đủ CHƯA CÓ (cần L1 100k/mutation/soak); chỉ có 'v2 nightly --only-miri' — Miri trên tập chọn (KT-17, D2-47(a)); Miri rời: 'v2 miri'" >&2
            exit 2
        fi
        ;;
    miri) do_miri "$@" ;;
    rules)
        root="$V2_ROOT"
        if [ "${1:-}" = "--root" ] && [ -n "${2:-}" ]; then
            root="$2"
        elif [ -n "${1:-}" ]; then
            echo "v2: 'rules' chỉ nhận --root <thư mục>" >&2
            exit 2
        fi
        if [ ! -d "$root" ]; then
            echo "v2: không có thư mục $root" >&2
            exit 2
        fi
        if rules "$root"; then
            echo "rules: PASS ($root)"
            exit 0
        fi
        echo "rules: FAIL ($root)" >&2
        exit 1
        ;;
    "" | -h | --help | help) usage ;;
    *)
        echo "v2: lệnh không biết: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac

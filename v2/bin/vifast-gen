#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# `vifast-gen gen` sinh code+docs; `vifast-gen --check` là gen-check của cổng.
set -u
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
PY=""
for c in python3.12 python3.11 python3; do command -v "$c" >/dev/null 2>&1 && { PY="$c"; break; }; done
[ -n "$PY" ] || { echo "vifast-gen: không thấy python3.11+" >&2; exit 1; }
if [ "${1:-}" = "gen" ]; then shift; exec "$PY" "$ROOT/v2/tools/vifast-gen/gen.py" --root "$ROOT" "$@"; fi
exec "$PY" "$ROOT/v2/tools/vifast-gen/gen.py" --root "$ROOT" "$@"

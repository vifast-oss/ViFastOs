#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# `vifast-trace` — giải mã dump trace nhị phân 32 B (D2-09/D2-40, KT-403).
# `vifast-trace <tệp> [--json] [--limit N] [--kind ipc]` | `vifast-trace --selftest`
set -u
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
PY=""
for c in python3.12 python3.11 python3; do
    command -v "$c" >/dev/null 2>&1 && "$c" -c 'import struct' >/dev/null 2>&1 && { PY="$c"; break; }
done
[ -n "$PY" ] || { echo "vifast-trace: không thấy python3" >&2; exit 1; }
exec "$PY" "$ROOT/v2/tools/vifast-trace.py" "$@"

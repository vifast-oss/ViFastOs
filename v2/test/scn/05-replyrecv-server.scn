version = 1
name = "05-replyrecv-server"
tags = ["call-reply"]
caps = { u0 = "Untyped", c0 = "CNode", c1 = "CNode", ep0 = "Endpoint", ep1 = "Endpoint", ntf0 = "Notification", tcb0 = "Tcb", tcb1 = "Tcb", rep0 = "Reply", sc0 = "SchedContext" }
thread = [
  { name = "client", steps = [
    "call cap=ep0 => ok",
    "nb_recv cap=ep0 => Busy",
  ] },
  { name = "server", steps = [
    "reply_recv reply=rep0 cap=ep1 => ok",
  ] },
]

version = 1
name = "17-call-no-reply-bit"
tags = ["no-reply"]
caps = { u0 = "Untyped", c0 = "CNode", c1 = "CNode", ep0 = "Endpoint", ep1 = "Endpoint", ntf0 = "Notification", tcb0 = "Tcb", tcb1 = "Tcb", rep0 = "Reply", sc0 = "SchedContext" }
thread = [
  { name = "t0", steps = [
    "call cap=ep0 no_reply=1 => ok",
  ] },
  { name = "server", steps = [
    "recv cap=ep1 => ok",
  ] },
]

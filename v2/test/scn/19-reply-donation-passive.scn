# SPDX-License-Identifier: MIT OR Apache-2.0
version = 1
name = "19-reply-donation-passive"
tags = ["donation"]
caps = { u0 = "Untyped", c0 = "CNode", c1 = "CNode", ep0 = "Endpoint", ep1 = "Endpoint", ntf0 = "Notification", tcb0 = "Tcb", tcb1 = "Tcb", rep0 = "Reply", sc0 = "SchedContext" }
thread = [
  { name = "client", steps = [
    "call cap=ep0 => ok",
  ] },
  { name = "server", steps = [
    "recv cap=ep1 => ok",
    "invoke SchedContext.Bind sched=sc0 target=rep0 => ok",
    "send cap=rep0 => ok",
  ] },
]

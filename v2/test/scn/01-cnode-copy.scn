# SPDX-License-Identifier: MIT OR Apache-2.0
version = 1
name = "01-cnode-copy"
tags = ["cap-copy"]
caps = { u0 = "Untyped", c0 = "CNode", c1 = "CNode", ep0 = "Endpoint", ep1 = "Endpoint", ntf0 = "Notification", tcb0 = "Tcb", tcb1 = "Tcb", rep0 = "Reply", sc0 = "SchedContext" }
setup = [
  "invoke Untyped.Retype cap=u0 size_bits=12 flags=0 => ok",
]
thread = [
  { name = "t0", steps = [
    "invoke CNode.Copy cnode=c0 src=u0 dst=c1 => ok",
    "invoke CNode.Copy cnode=c0 src=u0 dst=c1 => SlotOccupied",
    "invoke CNode.Move cnode=c0 src=u0 dst=c1 => ok",
  ] },
]

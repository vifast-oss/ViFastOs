# SPDX-License-Identifier: MIT OR Apache-2.0
version = 1
name = "12-suspend-abort-while-reply-wait"
tags = ["kill-blocked"]
caps = { u0 = "Untyped", c0 = "CNode", c1 = "CNode", ep0 = "Endpoint", ep1 = "Endpoint", ntf0 = "Notification", tcb0 = "Tcb", tcb1 = "Tcb", rep0 = "Reply", sc0 = "SchedContext" }
thread = [
  { name = "client", steps = [
    "call cap=ep0 => ok",
  ] },
  { name = "procsrv", steps = [
    "recv cap=ep1 => ok",
    "invoke Tcb.Suspend tcb=tcb0 mode=Abort => ok",
    "invoke Tcb.Suspend tcb=tcb1 mode=Defer => InvalidArgument",
  ] },
]

version = 1
name = "10-suspend-while-blocked-on-reply"
tags = ["suspend-blocked"]
caps = { u0 = "Untyped", c0 = "CNode", c1 = "CNode", ep0 = "Endpoint", ep1 = "Endpoint", ntf0 = "Notification", tcb0 = "Tcb", tcb1 = "Tcb", rep0 = "Reply", sc0 = "SchedContext" }
thread = [
  { name = "victim", steps = [
    "call cap=ep0 => ok",
  ] },
  { name = "procsrv", steps = [
    "recv cap=ep1 => ok",
    "invoke Tcb.Suspend tcb=tcb0 mode=Abort => ok",
  ] },
]

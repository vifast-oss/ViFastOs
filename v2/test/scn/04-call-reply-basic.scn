version = 1
name = "04-call-reply-basic"
tags = ["call-reply"]
caps = { u0 = "Untyped", c0 = "CNode", c1 = "CNode", ep0 = "Endpoint", ep1 = "Endpoint", ntf0 = "Notification", tcb0 = "Tcb", tcb1 = "Tcb", rep0 = "Reply", sc0 = "SchedContext" }
thread = [
  { name = "client", steps = [
    "call cap=ep0 mr=1,2 => ok",
  ] },
  { name = "server", steps = [
    "recv cap=ep1 => ok",
    "send cap=rep0 mr=3 => ok",
  ] },
]

# SPDX-License-Identifier: MIT OR Apache-2.0
# KT-42 — shared read-only frame end-to-end: **một** Frame map READ vào hai VSpace; đọc được
# từ cả hai, ghi ⇒ Permission, không cấp bản sao, huỷ một bên còn đúng bộ đếm (k2-vm.md §16).
version = 1
name = "26-shared-readonly-frame"
tags = ["vm-shared"]
harts = 1
caps = { c0 = "CNode", t0 = "Tcb", t1 = "Tcb", ep0 = "Endpoint", rep0 = "Reply" }
thread = [
  { name = "t0", steps = [
    "vm_map vs=vs0 va=0x1000 frame=f4 rights=READ attrs=WB => ok",
    "vm_map vs=vs1 va=0x2000 frame=f4 rights=READ attrs=WB => ok",
    "vm_expect_counters frame=f4 maps=2 w=0 x=0 => ok",
    "vm_expect_map vs=vs0 va=0x1000 frame=f4 size=12 => ok",
    "vm_expect_map vs=vs1 va=0x2000 frame=f4 size=12 => ok",
    "vm_dispatch hart=0 tcb=t0 => ok",
    "vm_touch hart=0 vs=vs0 va=0x1000 access=Read => ok",
    "vm_touch hart=0 vs=vs1 va=0x2000 access=Read => ok",
    "vm_touch hart=0 vs=vs0 va=0x1000 access=Write => ok",
    "vm_expect_fault tcb=t0 vs=vs0 va=0x1000 access=Write reason=Permission => ok",
    "vm_procsrv_recv => ok",
    "vm_procsrv_resume tcb=t0 => ok",
    "vm_unmap hart=0 vs=vs0 va=0x1000 => ok",
    "vm_expect_counters frame=f4 maps=1 w=0 x=0 => ok",
    "vm_unmap hart=0 vs=vs1 va=0x2000 => ok",
    "vm_expect_counters frame=f4 maps=0 w=0 x=0 => ok",
    "vm_expect_frames n=3 => ok",
    "vm_check => ok",
  ] },
]

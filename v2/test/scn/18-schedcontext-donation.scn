# SPDX-License-Identifier: MIT OR Apache-2.0
version = 1
name = "18-schedcontext-donation"
tags = ["donation"]
caps = { sc_ctl = "SchedControl", sc0 = "SchedContext", rep0 = "Reply", ep0 = "Endpoint", ep1 = "Endpoint" }
setup = [
  "invoke SchedControl.Configure sched_control=sc_ctl sched=sc0 budget=1000 period=10000 => ok",
]
thread = [
  { name = "client", steps = [
    "call cap=ep0 => ok",
  ] },
  { name = "server", steps = [
    "recv cap=ep1 => ok",
    "invoke SchedContext.Bind sched=sc0 target=rep0 => ok",
    "send cap=rep0 => ok",
  ] },
]

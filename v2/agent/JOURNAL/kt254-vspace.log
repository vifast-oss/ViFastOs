# qg_boot rc=0 (QEMU tự thoát), marker_count=1, không PANIC, không '# trap:' ngoài dự kiến.
# ESR 0x96000006: EC=0x25 (Data Abort from same EL), WnR=0 (đọc), DFSC=0x06 (translation fault
# level 2) — đúng "đọc VA chưa map". FAR=0x60000000 = đúng VA đã unmap.


# v2/kernel/vifast-kbin-riscv64/Cargo.toml (trich nguyen van)
# **KT-77b** (OD-K6-2): ảnh **sản phẩm** có U-mode + procsrv + shell. Bật `user` (không `ktest`)
# nên ảnh **không** link module harness nào (D2-08) — kiểm bằng máy ở
# `v2/agent/JOURNAL/kt77b-harness-scan.sh`. Ca âm của tiêu chí 3 = build **không** feature này
# (`bash v2/tools/repro-build.sh` mặc định) ⇒ runner parity phải đỏ `exit 5`.
product-shell = ["user"]
# **KT-77c** (D2-123.2): ảnh **sản phẩm** có **FS + virtio-blk** — `ls`/`cat`/ghi tệp/đọc lại sau
# reboot. Tách `product-fs` khỏi `product-shell` để **ca âm tiêu chí 5(c)** build được ảnh có shell
# **không** FS (parity FS phải đỏ). Nhãn `block` (crate arch) **không** kéo `ktest` — bài học
# KT-77b cho virtio-blk (`vblk = ["ktest"]` trước KT-77c).
product-fs = ["product-shell", "vifast-plat-riscv64/block"]
# KT-73: ảnh `ktest-con` — UART RX IRQ → ring → U-mode + virtio-console hai queue. Ảnh sản phẩm

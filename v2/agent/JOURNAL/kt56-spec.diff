diff --git a/spec/abi.toml b/spec/abi.toml
index f408cfe5..2f1623e8 100644
--- a/spec/abi.toml
+++ b/spec/abi.toml
@@ -264,11 +264,31 @@ variants = { reason = ["Timeout", "Budget"] }
 [method_signature.state.Running]
 fields = ["hart"]
 
-# D2-25: Exit mang theo mã thoát trong fault message; `BlockedOnSend.fault` là bổ sung D2-33.
+# D2-25 + **D2-56a/KT-56**: `FaultKind` ĐẦY ĐỦ (mở `spec/abi.toml` **một lần** — D2-72 Q1).
+# `Exit` đi đường Send **không Reply** (D2-25); `Vm`/`UnknownSyscall`/`UserException` đi Call +
+# Reply tới `fault_ep` (procsrv K3.5). Đây là **cùng** enum mô hình K2 (`v2/sim/vifast-sim/src/
+# tcb.rs`), chỉ khác `vspace` là **nhãn u64** (ASID/ObjId) thay vì kiểu nội bộ của từng backend.
+#
+# Bảng trap phần cứng → `FaultKind` (K3, `v2/docs/k3-riscv64.md` §19):
+#   scause 12/13/15 (page fault)      → `Vm`; `access` = Execute/Read/Write theo scause,
+#                                        `va` = `stval`, `reason` từ PTE: invalid ⇒ `NotMapped`,
+#                                        U/S sai hoặc thiếu quyền ⇒ `Permission`,
+#                                        ghi trang X / thực thi trang W ⇒ `Wx`.
+#   scause 2 (illegal), 3 (breakpoint), 0/1/4/5/6/7/9 (misaligned/access/call) → `UserException`
+#                                        (`ip` = `sepc`, `kind` = `scause`).
+#   syscall Exit(14)                  → `Exit{code}` (không phải trap).
+#   `UnknownSyscall` là biến thể ABI cho procsrv K3.5; K3 không tạo từ phần cứng (D2-79 trả
+#   `RangeError` 19 cho số ngoài dải 0..15).
 [method_signature.fault_kind]
-names = ["Exit"]
+names = ["Exit", "Vm", "UnknownSyscall", "UserException"]
 [method_signature.fault_kind.Exit]
 fields = ["code: u64"]
+[method_signature.fault_kind.Vm]
+fields = ["vspace: u64", "va: u64", "access: Read|Write|Execute", "reason: NotMapped|Permission|Wx"]
+[method_signature.fault_kind.UnknownSyscall]
+fields = ["nr: u64"]
+[method_signature.fault_kind.UserException]
+fields = ["ip: u64", "kind: u64"]
 
